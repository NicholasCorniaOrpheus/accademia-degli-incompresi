  \fill-line{
	\hspace #1
	\column{
		\line{E quando per li prati}
		\line{Coglie fiori odorati}
		\line{N'apre pi`u col bel pie che non ne coglie}
                \line{E co'l bel uiso il pregio a tutti toglie.}
                \line{Che i bei rai}
		\line{Faccian lieto un mio sol giorno}
		\vspace #1
		\line{E quando in fiume o fonte}
		\line{Specchia la uaga fronte}
		\line{Si fa l'onde d'argento e ferma il fiuma}
		\line{Per uagheggiarla, il natural costume.}

		}
	\hspace #1
	\column{
		\line{E quando fra le rose}
		\line{Spira note amorose}
		\line{Al suon de suoi soavi e dolci accenti}
		\line{L'Acqua, e la Terra, e'l ciel ui stanno intenti.}
		\vspace #1
		\line{Felice te felice}
		\line{O bella uincitrice}
		\line{Della Terra, e del Ciel che marauiglia}
		\line{Fia, se mi uinci ad un girar de ciglia.}

	}
