\markup{
  \fill-line{
	\column{
		\line{1 Tu scherzando hor fuggi hor riedi}
		\line{Hor ti fiedi}
		\line{Lieuemente in quel bel petto}
                \line{Hor increspi i capei biondi}
                \line{Hor t'ascondi}
		\line{Entro al labro amorosetto}
		\vspace #1
		\line{2 Con quante arte l'aure molci}
		\line{Come dolci}
		\line{Moui, e freschi i tuoi sospiri}
		\line{Come in tanto lusingando}
		\line{Vai predando}
		\line{Quell'odor che grato spiri}
		\vspace #1
		\line{5 Freddo spirto (ah) si beato}
		\line{Nel suo stato}
		\line{Senza gelo non saresti}
		\line{Si possenti}
		\line{Che d'amor meco arderesti.}

		}
	\hspace #1
	\column{
		\line{3 Non però le rose, e gigli}
		\line{Onde pigli}
		\line{Le tue gratie perdon mai}
		\line{Il tesor che stassi accolto}
		\line{In quel volto}
		\line{Ch'è del sol piu chiaro assai}
		\vspace #1
		\line{4 O tre volte, e piu felice}
		\line{Te cui lice}
		\line{Vagheggiar l'amo sembiante}
		\line{E baciarlo mentre in vano}
		\line{Quasi insano}
		\line{Verso (oime) lagrime tante.}

	}
  
  }
