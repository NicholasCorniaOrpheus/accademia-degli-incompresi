adi:M9CeVDhwbT4n a rdfs:Resource ;
    rdfs:label "Al vago e incerto gioco di primiera (Striggio)" ;
    <> adi:4tXtVLNjEeQy,
        adi:kAeHmSyQi4Y8 ;
    pdc:text """Al vago e incerto gioco di primiera
chi vol giocar dui scudi per piacere
... siamo qui in cinque
... ecole qui signor polit'e belle
mescolatelle a un tratto
e poi faccia a chi tocc'il primo sette

[Or date fuor de' grossi e 'l gross'istesso]
di che caviamo ...
vad'il mio grosso
il voglio
dattene quattro
i scarto
mal aggia chi di quella fu inventore
a me giuoca 'l mio resto
passa a monte
vada il resto mio
il voglio anch'io
tutti scartiam
et io a primiera
voglio far manco
farò primiera
eccola quivi
nulla tirate""" ;
    dc:subject adi:7SiSdUEKzaiU ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/011940001010101_000000233500C> ;
    dcterms:type "MusicComposition" ;
