adi:UeivD9QaRWgj a rdfs:Resource ;
    rdfs:label "Marte, e Cupido, amici dolci, e cari" ;
    <> adi:NYFsLcyKkgrn,
        adi:ZU5ZzNrZfToD ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Marte, e Cupido, amisi dolci, e cari,
De chi de l'arme, e d'amor se deleta.
Deme gratia, e favor, che fazza chiari
De quel, che ho in fantasia, chi al dir m'aspeta:
E son ligao, co se le nave a i fari,
Fina che'l tempo al mio camin s'asseta:
Marte sia il mio timon, Cupido vela.
E l'un, e l'altro mio peota, e stela.""" ;
    dc:subject adi:hHij3iF3zFE9 ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:5MwBnJaT8JKD ;
    ns1:P180 adi:GfJn75HsAD4J,
        adi:MfBWzgNTqiki,
        adi:forZLBVMjEfd ;
