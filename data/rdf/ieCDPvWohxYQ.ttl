adi:ieCDPvWohxYQ a rdfs:Resource ;
    rdfs:label "Non dimen sento in me, sì grave sdegno" ;
    <> adi:fNQ3Yu7akyGg,
        adi:faqWLBNJVmjy ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Non dimen sento in me, sì grave sdegno
Donne vaghe, e gentil di virtù piene,
Quand'odo qualche rima, o verso indegno,
Che solo in biasmo vostro si contiene,
E in tanta rabbia, e il tal furor divegno,
Che s'io fussi fra i Ceppi, e le Catene,
Le spezzerei, e pigliarei l'inchiosto
Per venire a difender l'honor vostro.""" ;
    dc:subject adi:jSo2wG8h9SDa,
        adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P180 adi:LBUMoVayqW8X,
        adi:TrnoRtA45mkr,
        adi:XEsomeCuBNMG,
        adi:jAqiUUC7GsgE ;
    ns1:P2551 adi:NtX3nd34H3Wn .

