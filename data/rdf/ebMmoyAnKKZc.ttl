adi:ebMmoyAnKKZc a rdfs:Resource ;
    rdfs:label "Bastami un guardo solo" ;
    <> adi:B5dDXV6qVG2p,
        adi:SnB9APyQXi5U ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Bastami un guardo solo
Ma lieto anima mia, per far ch'io viva;
A che vostra beltà dunque men priva?
Già negar nol dovete,
Né con giusta cagion farlo potete.
Perché mostra impietà chi non concede.
Ad un lungo servir qualche mercede.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F033570000101_PPPP00023100C> ;
