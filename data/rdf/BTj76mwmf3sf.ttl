adi:BTj76mwmf3sf a rdfs:Resource ;
    rdfs:label "Urnula quam gemmis auroque; nitere videmus" ;
    <> adi:4Z4eXm9TQs4C,
        adi:eY9VyUGp6KLy ;
    pdc:text """Urnula, quam gemmis auroque; nitere videmus
Quaeritur angusto quid ferat illa sinus
Haud ea pestifero Pandorae infecta veterno
Intulit omnivagas orbe adaperta febres.
At pretium, quo non aliud pretiosius, ipsa haec
Quod rerum amplexus non capit, urna capit.""" ;
    dc:description "Praise to the Eucharistic urn, and its hidden content. But also it can be interpret as the urn of aleatoric outcome?" ;
    dc:subject adi:RmaA75A9H4A7,
        adi:kiy25fDKSzMY ;
    dcterms:type "PoeticWork" ;
