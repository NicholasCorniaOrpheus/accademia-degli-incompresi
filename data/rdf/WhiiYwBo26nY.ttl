adi:WhiiYwBo26nY a rdfs:Resource ;
    rdfs:label "Quanto più voi Laura gentil riguardo (Agostini)" ;
    <> adi:SjqizepxoSSs,
        adi:XSLwZmE43osQ ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Quanto più voi LAURA gentil riguardo,
Ogn'hor più ardo,
Perché m'aventa Amore,
Ma di ciò non mi pento,
Anzi ne son contento,
Purché voi siate pia,
E come vostro io son, voi siate mia.""" ;
