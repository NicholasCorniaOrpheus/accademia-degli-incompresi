adi:ZpExFrpwRshL a rdfs:Resource ;
    rdfs:label "In un boschetto adorno" ;
    <> adi:4iQL4zuQfNQR,
        adi:B5dDXV6qVG2p ;
    pdc:poeticType adi:ZTekfwVRnUbd ;
    pdc:text """In un boschetto adorno
Di vaghe erbette e fiori,
Sopra la fresca riva d'un ruscello.
Stava nel mezo giorno
L'inamorata Clori
Sola cantando a piè d'un arboscello.
Ogni vezzoso augello,
La cristallina linfa,
Con la quieta fronda,
E con l'immobil'onda
Il canto udia di così bella Ninfa:
Ch'istrutta già d'Amore
Chiamava il suo pastore.""" ;
    dc:subject adi:5RYVLh7yR4s6 ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F033580000101_PPPP00055300C> ;
    dcterms:type "PoeticWork" ;
