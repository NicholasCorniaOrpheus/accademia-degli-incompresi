    wdt:P870 adi:UzQqDq2qMKwd ;
    ns1:P180 adi:Rq5MFqmMSfYb,
        adi:XF9vnVnjvEzN,
        adi:itAFZTrSnPxJ ;
    ns1:P2551 adi:FPYzaHuDcPWK .

