adi:ndC4fH77E3cD a rdfs:Resource ;
    rdfs:label "S'amanti provar mai tormenti fieri" ;
    <> adi:7TvK2MaWYE9G,
        adi:YXSurDyNHSdr ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """S'Amanti provar mai tormenti fieri  
Con lagrime provargli, e con sospiri  
D'Angelica gli accesi Cavalieri,  
Che meritar Corona di martiri;
Quel dì, che in mezzo de lor Cori alteri  
Già colmi di speranze, e di desiri,  
Sonò come il felice, e bel Medoro  
Sentiti i frutti havea del sudor loro.""" ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P180 adi:KH2RsQHZMHpE,
        adi:oUWx5eNXyXqj ;
    ns1:P2551 adi:NtX3nd34H3Wn .

