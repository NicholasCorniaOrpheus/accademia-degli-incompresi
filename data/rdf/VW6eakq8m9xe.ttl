adi:VW6eakq8m9xe a rdfs:Resource ;
    rdfs:label "Occhi lusenti onesti e amorosetti (Agostini)" ;
    <> adi:SkU8K6nXSqeb,
        adi:XtiKQkt7awAq,
        adi:hiE7NEWM6ThN ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Occhi lusenti onesti e amorosetti
Occhi soavi e cari
Occhi sereni vagh'e lizadretti
Occhi bei neri e chiari
Daspuò che no ve vezo
Sto mal imò sto pezo
Deh occhi fé retorno
Azzò no mora un zorno.""" ;
