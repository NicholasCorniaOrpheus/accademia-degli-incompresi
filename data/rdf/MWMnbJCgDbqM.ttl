adi:MWMnbJCgDbqM a rdfs:Resource ;
    rdfs:label "Filli caro ben mio" ;
    <> adi:4iQL4zuQfNQR,
        adi:B5dDXV6qVG2p ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Filli caro ben mio,
Da quelle dolci labbia
Deh fa ch'un bacio solo, un sol bacio habbia,
Prendilo Alessi, ch'io
O dar non lo saprei,
O dandolo morrei.
Oh dolci baci, dolcemente impressi,
Oh mia Filli, o mio Alessi.""" ;
    dc:description "Poem depicting the return of light after the darkness of night, thanks to the Sun." ;
