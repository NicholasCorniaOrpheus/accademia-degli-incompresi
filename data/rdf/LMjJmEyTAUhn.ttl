adi:LMjJmEyTAUhn a rdfs:Resource ;
    rdfs:label "Dal mare, oh Margherita, il nome avesti" ;
    <> adi:RidaxpYHRDz3,
        adi:nxtaeZb4ETk2 ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Dal mare, oh Margherita, il nome havesti.
Ma chi de le tue luci i rai vegheggia,
Scorge ne gli occhi tuoi vanti celesti,
Che l'eterna beltate in te lampeggia.
Sorse Vener crudel dai flutti infesti,
Ed hebbe per natal l'ondosa reggia:
Ma tu gradita uscendo a l'aura fuore
Sei nel mar di beltà Vener d'Amore.""" ;
    dc:subject adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P180 adi:9bHS2Z6zpJ6k,
        adi:LBUMoVayqW8X ;
    ns1:P2551 adi:NtX3nd34H3Wn .

