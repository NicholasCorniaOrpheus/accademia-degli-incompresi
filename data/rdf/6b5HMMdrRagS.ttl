adi:6b5HMMdrRagS a rdfs:Resource ;
    rdfs:label "Non si curi del ciel chi in terra vive" ;
    <> adi:3KxURtKJVxAF,
        adi:LgvtnF7kZsg4 ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Non si curi del Ciel, chi in terra vive  
Felice amando, e del suo amor contento; 
Né lassù brami fra le cose dive  
Sentir la gioia, ove ogni spirto è intento;
Perch'al sommo diletto par che arrive  
Solo il gioco Amoroso, è in quel momento; 
Che de la donna sua si bascia il viso,  
S'ha il medesimo ben, ch'è in Paradiso.""" ;
    dc:subject adi:o2i89qrxS3XR ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:YGRByAyckPA5 ;
    ns1:P2551 adi:FPYzaHuDcPWK .

