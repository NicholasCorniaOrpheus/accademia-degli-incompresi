adi:Rxay4ShTVrq6 a rdfs:Resource ;
    rdfs:label "Amor già, che tu vuoi pur ch'io m'arrischi" ;
    <> adi:Uej5HRzC3qS3,
        adi:gJigWkauAvXU ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Amor già, che tu vuoi pur ch'io m'arrischi
In udir, e vedere
Sirene, e Basilischi;
Fammi gratia Signore,
S'egli avien ch'io mi strugga a lo splendore
Di duoi occhi sereni, & che io sia preda
D'un ragionar accorto;
Che chi ne è colpa, creda
Che per veder, & per udir sia morto.
Gentil coppia Eccellente,
Chi vi mira & ascolta
Solamente una volta;
Et non muor di piacere,
Può gir arditamente
Ad udir e vedere
Le Sirene d'Amor, e i Basilischi.""" ;
    dc:subject adi:KuorvRGvXbTz ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F070240000101_PPPP00278300C> ;
    dcterms:type "PoeticWork" ;
