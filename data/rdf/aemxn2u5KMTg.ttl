adi:aemxn2u5KMTg a rdfs:Resource ;
    rdfs:label "Qual fu, qual è, qual fia" ;
    <> adi:Kq4PswoDPxtR,
        adi:exrSSpj73NMW ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Qual fu, qual è, qual fia,
Cantando l'immortali
Perché tra lor lo stato dei mortali:
Il cantar nostro sia
Simile a quel; siam'tre canta tu Lisa,
Tu canta, Amor, & io
Canterò canterem'lo stato mio:
Cantiamo in dolce guisa,
Come fu, come fia, com'è dolente
Il passato, il futuro, ed'il presente.""" ;
    dc:subject adi:5f6kHhAxyPZh ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/010780000101_PPPP00245600C> ;
    dcterms:type "PoeticWork" ;
