adi:XgMMtHD9aPsW a rdfs:Resource ;
    rdfs:label "Donne leggiadre, ne' cui lumi ardenti" ;
    <> adi:ZfF8tq3cpZ9P,
        adi:dApepuXKvEo3 ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Donne leggiadre, ne' cui lumi ardenti
Mirar non sdegna anzi specchiarsi il Sole
E fate co' bei raggi alti, e lucenti
Nascer, quando più aggiaccia, erbe, e viole.
Non siate, prego, questi rozzi accenti,
Né il basso suon, queste mie parole
Sdegnose in ascoltar, mentre col canto
Cerco inalzar le lodi vostre, e 'l vanto.""" ;
    dc:description "Verses in defense of women, too often attacked by unjust critiques." ;
    dc:subject adi:F4Q6mPjKkDUQ,
        adi:duqiuAVT6ZNg ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:Dw8U7c9dKgjv,
