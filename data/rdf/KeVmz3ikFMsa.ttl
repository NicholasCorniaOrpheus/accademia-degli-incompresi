adi:KeVmz3ikFMsa a rdfs:Resource ;
    rdfs:label "Oh viver mio noioso oh adversa sorte (Anonymous)" ;
    <> adi:3GeGzceidQYB,
        adi:cXoy2Cq2fMs4,
        adi:dnKqeJdTP2sv ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Oh viver mio noioso oh adversa sorte,
Cerco l'oscurità fuggo la luce,
Bramo la morte,
Quel ch' agli occhi altrui noce a me riluce,
Perché chiudendo lor s'apron le porte,
Alla cagion ch'al mio sol mi conduce.""" ;
