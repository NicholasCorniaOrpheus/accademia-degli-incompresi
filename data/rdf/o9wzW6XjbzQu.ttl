adi:o9wzW6XjbzQu a rdfs:Resource ;
    rdfs:label "Fermano il corso ai venti (Milleville)" ;
    <> adi:4fam9RTzpsG4,
        adi:JXwh4igXGs97,
        adi:YdXiLDnH4XMc ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Fermano il corso ai venti 
E rapiscono l'alme 
Tarquinia dolce i tuoi soavi accenti 
E se per le bellezze d'un'altra Giove dal superno coro 
Scese nei boschi e transformos'intorno 
Hor l'eterna armonia 
Lascia dal ciel e vien humil fra noi 
Ombra vana ad udir gl'accenti tuoi.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/102390000010101_000000161700C> ;
    dcterms:type "MusicComposition" ;
