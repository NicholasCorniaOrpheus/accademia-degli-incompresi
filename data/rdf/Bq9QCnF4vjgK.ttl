adi:Bq9QCnF4vjgK a rdfs:Resource ;
    rdfs:label "M'è pur stato dal core" ;
    <> adi:6FSwyQUqdeCQ,
        adi:RWJhybDuQZd4,
        adi:ZmhzcSbPoocH ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """M'è pur stato dal core
Furtivamente il Lauro
Svelto, che già tu vi piantasti Amore.
E tu'l vedi, e consenti,
Che quel, che l'ha rapito
Non debba esser punito?
Ma temo, che paventi
Punir chi l'ha rubato,
Sol perch'ancor tu sei di furto nato.""" ;
    dc:subject adi:duqiuAVT6ZNg ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F160220000010101_000000090400C> ;
