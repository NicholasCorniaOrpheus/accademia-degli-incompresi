adi:hJBTRcEc3oan a rdfs:Resource ;
    rdfs:label "Mentre l'alte promesse a mille a mille" ;
    <> adi:RPt3AF9FDvgd,
        adi:oGnKtr52k4Ac ;
    pdc:poeticType adi:Mzrr2esvFbco ;
    pdc:text """Mentre l'alte promesse a mille a mille
Con mentita pietà non m'ingannaro
Furon le fiame mie dolci e tranquille,
E'l dolor e 'l piacer corsero al paro.
Crebbero poi sì calde le faville,
Sommerse il poco dolce il molt'amaro,
E sì corse l'infermo mio desio
Che la speranza col tardar morio.""" ;
    dc:subject adi:oNwZL9SndUgS ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
    ns1:P180 adi:c4Xg69omaPKA ;
    ns1:P2551 adi:emwSSkhQpsBS .

