adi:dWBRjZgF6HTT a rdfs:Resource ;
    rdfs:label "Ne la dolce stagion di Primavera" ;
    <> adi:baADqnLF4t7X,
        adi:mhGX2rwoBen9 ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Ne la dolce stagion Di primavera
Senza foglie vedrò mirti et allori
Di vern'al ghiaccio i fiori
Sorger lieti e fiorir rose e viole
Pria che da voi mio sole
Sciolga quest'alma o che per altr'oggetto,
Nuovo foco d'amor mi scald'il petto.""" ;
    dc:description "There seems to be any poetry collection including this poem by Molza, except from the madrigal by Vinci." ;
