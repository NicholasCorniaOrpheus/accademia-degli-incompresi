adi:gFUmSNTaKosW a rdfs:Resource ;
    rdfs:label "Anchor che da voi stelle siate tali" ;
    <> adi:fNQ3Yu7akyGg,
        adi:faqWLBNJVmjy ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Anchor che da voi stelle siate tali,
Che da ogni tarra, che data vi sia,
O fatto dishonor da tali, e quali,
Ch' in biasmo vostro parlan tutta via,
Difender vi potiate, anzi con l'ali
Del nome vostro, ond'ogni ben s'invii,
Al mondo dimostrar chiaro, e aperto
Quanto in voi splenda, d'alta gloria il merto.""" ;
    dc:subject adi:jSo2wG8h9SDa,
        adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P180 adi:NUaQe9C3WPVp,
        adi:PD77VU2hvP2t ;
    ns1:P2551 adi:NtX3nd34H3Wn .

