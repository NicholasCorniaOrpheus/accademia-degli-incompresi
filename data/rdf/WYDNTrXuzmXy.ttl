adi:WYDNTrXuzmXy a rdfs:Resource ;
    rdfs:label "Oh Phebo, oh Sole, universal Natura" ;
    <> adi:7co2fT7Qfby2,
        adi:BVavFPBEeQRA,
        adi:fwobE2DWRXRY ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Oh Phebo, oh Sole, universal Natura
Dal caotico Mondo al mondo uscita,
De la Terra, e del Ciel moto, e misura,
De la luce vital Fonte infinita
Tu de i quattro Elementi Essenza pura,
Di questa purità Semplice Vita,
Tu fluid'Or, Tu l'humido Thesauro,
Ch'al tuo Lume central s'indura in Auro.""" ;
    dc:subject adi:ZfsD5EcdZsxp,
        adi:jpEmjHi9Ym4c ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
    skos:altLabel "O Phebo, o Sole, universal Natura" ;
