adi:5aDMi6QnbvxH a rdfs:Resource ;
    rdfs:label "Quando sarà ch'io mora" ;
    <> adi:aPSR2wpq8iGj,
        adi:hi5GzysL3aMZ ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Quando sarà ch'io mora,
Amor, se ’n questa cruda dipartita
Non può tanto dolor finir mia vita?

Qualor avien ch'io pensi
Quel che dir mi volea l’ultimo sguardo
E'l partir lento e tardo,
con quei sospir sì accensi,
come pon star in me l’anima e i sensi?

S'allor ch'io gli odii dire
Quell'ultime parole in tanto ardore
Non mi s’aperse il core,
E non potei morire,
Quando potrò mai più di vita uscire?

Io n'uscirò, ch'a tant'aspro martire
Non potrò già durar, vedermi priva
E sì lungi da lui, e che sia viva!""" ;
    dc:description "The poem describes the division of the soul in separation as it seeks to maintain union with the absent beloved" ;
    dc:subject adi:Pfqef5YBTXjD ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P180 adi:MfBWzgNTqiki ;
    ns1:P2551 adi:6r7ZsMDvqt7K,
