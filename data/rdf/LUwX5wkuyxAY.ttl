adi:LUwX5wkuyxAY a rdfs:Resource ;
    rdfs:label "Crudel fiera selvaggia (Viola)" ;
    <> adi:eJkZtqiCPcgu,
        adi:koYRuMoaxBMQ ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Crudel fiera selvaggia
Contr'un vero fedele
Tant'ire, tanti sdegni e tai querele
Il cor m'infoc'acceso
I miei continui guai 
Il mio duol, il mio languire
Dovria haver omai
Trovar alcun compenso 
E far conform'al mio vero desire
E voi per più martire 
Crudel più che crudele
Con poco mel mischiat'un tanto fele.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F061730000010101_000000076800C> ;
    dcterms:type "MusicComposition" ;
