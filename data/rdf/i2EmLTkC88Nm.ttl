adi:i2EmLTkC88Nm a rdfs:Resource ;
    rdfs:label "Monti selve fontane piagg'e sassi" ;
    <> adi:23rCvdgVPxoA,
        adi:dbbU5aPBAxvp ;
    pdc:poeticType adi:8cSCusLrr4RD ;
    pdc:text """Monti selve fontane piagg'e sassi
Vo cercand’io, se pur potessi un giorno
In parte rallentar l’acerbo pianto;
Ma ben veggio or che solo in una valle
Trovo riposo alle mie stanche rime,
Che mormorando van per mille campi.""" ;
