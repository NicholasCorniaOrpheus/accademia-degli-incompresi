adi:HnmSEqwVf5Sb a rdfs:Resource ;
    rdfs:label "Vi mando Signor mio del secco ingegno (Agostini)" ;
    <> adi:3ybFxsvJusaH,
        adi:TLwDygVEEnDQ ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Vi mando Signor mio del secco ingegno
I verdi frutti, e di miei canti il sono,
Né v'ingombrino il cor di fiero sdegno,
Poiché quanto poss'io, tanto vi dono.
Siano appò voi di servitude un pegno,
Che vostro fido, et humil servo sono,
Acciò col valor chiaro altero, e solo
Alzar mi possa a glorioso volo.""" ;
    dc:subject adi:ZfsD5EcdZsxp ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F305240000010101_000000002400C> ;
