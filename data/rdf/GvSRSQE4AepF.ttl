adi:GvSRSQE4AepF a rdfs:Resource ;
    rdfs:label "Ahi, ahi che se ne van tutte le notti" ;
    <> adi:5n6E2xua9xN3,
        adi:9ENdykkNtf6X,
        adi:JWr76UXJFZjt ;
    pdc:poeticType adi:UmZJdKF5x97H ;
    pdc:text """AHI ahi che se ne van tutte le notti
Né s'arresta giamai un hora il sole
fugge come balen la nostra vita
siegue dop'il gioir mai sempr'il pianto
Ogn'hor s'affretta di girare il cielo
Né riedon più i già passati giorni
son trist'i giorn'e pessime le notti
il ciel non porg'a me mai chiar'il sole
sol di pianto pasc'io quest'aspra vita.""" ;
    dc:subject adi:gcrqwjgvBQyM,
        adi:o2i89qrxS3XR ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F167770006010101_000000157100> ;
    dcterms:type "MusicComposition" ;
