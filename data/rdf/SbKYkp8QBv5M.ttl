adi:SbKYkp8QBv5M a rdfs:Resource ;
    rdfs:label "Che non è lieve trionfar de l'alme" ;
    <> adi:YYFRNeCKx9AL,
        adi:fXurj2BzALG4 ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Che non è lieve trionfar de l'alme,
Cui fan rigide voglie, un schermo altero;
I sen pria di valor poscia le salme
V'armai di saldo acciaro Amor severo;
E di mille guerrier vittrici palme
Lieti portaste al mio felice impero;
Felice un tempo, hor giù cader lo veggio,
S'a me da voi non vien, quel ch'a voi chieggio""" ;
    dc:subject adi:8GvHmwR26GRn,
        adi:o2i89qrxS3XR ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:86Q2aWNHHazc,
        adi:PkJjQdNqm3ok,
        adi:fxEcFxXeUjcY ;
