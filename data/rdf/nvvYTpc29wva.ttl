adi:nvvYTpc29wva a rdfs:Resource ;
    rdfs:label "Quisquis es upiliove bonus, bona vel caprimulga" ;
    <> adi:JptkH6PJEE5Z,
        adi:bvitCpafPTft ;
    pdc:text """QUISquis es upiliove bonus, bona vel caprimulga,
Siste grengem, & sacro munera fer cineri:
Da violas tumulo, fundat dulcissima vina
Cantharus, &tepido lacte madescat humus.
Dehinc lacrimans sic fare, Cinis carissime nobis,
Nunc cinis, ast olim candida Hyella vale.""" ;
    dc:subject adi:5RYVLh7yR4s6 ;
    dcterms:type "PoeticWork" ;
