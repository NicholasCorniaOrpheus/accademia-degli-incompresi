adi:55mTTFUbb8Er a rdfs:Resource ;
    rdfs:label "Vorrei parlar, ma l'ira in dir m'intoppa" ;
    <> adi:4qz9ARSJbUuJ,
        adi:MUzXCQRBaVpr ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Vorrei parlar, ma l'ira in dir m'intoppa,
Poiché sola difendo il nostro sesso,
Già il desiderio mio brama, e galoppa
Di vendicarsi, e pur non m'è concesso
Contra costor, ch'han sì la mente zoppa,
Appo noi donne; in darne o'traggi spesso,
Ma spero, che dal ciel verrà saetta,
Et credo che di noi farà vendetta.""" ;
    dc:subject adi:jSo2wG8h9SDa ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
