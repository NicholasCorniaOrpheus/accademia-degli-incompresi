adi:FRHyC2RRbdQm a rdfs:Resource ;
    rdfs:label "Già l'alma ti donai" ;
    <> adi:MW7UE9R8m7LS,
        adi:kUiiaYvUfK7o ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Già l'alma ti donai
Vivendo sol de la tua vista lieta;
Ma poi che rio pianeta
Mi costrinse a partire,
Per non vedermi inanzi a te morire
Pietoso mi dicesti
Vivi oh mia Filli, e l'alma mi rendesti.
Hor perché di te priva
Questa vita m'è schiva,
E sol morir desio
La dolent'alma a te di novo invio.""" ;
    dc:subject adi:HfQkYfWDVNZC ;
    dcterms:identifier <https://lyra.unil.ch/poems/20881>,
        <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/078890000101_PPPP00011000C> ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
