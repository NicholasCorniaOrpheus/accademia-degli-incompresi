adi:iawa8ZDutRug a rdfs:Resource ;
    rdfs:label "Donn'a cui molte gratiose, & belle" ;
    <> adi:P8BfrVPRhDGx,
        adi:RxWwpaTFwpCu ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Donn'a cui molte gratiose, & belle
Di gratia, e di beltà sono seconde,
Di sì bel corpo le fatezze Apelle
Ben pò ritrar, ma'l bel, ch'in se n'asdonde
L'alma pura e gentil, con tutte quelle
Gratie, ch'il ciel vi piove ampie, e feconde,
Chi dipinger disia, non può far fallo
Se v'assomiglia à un lucido cristallo.""" ;
    dc:subject adi:ndYmAKz88N5Q ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F027930000101_PPPP00100700C> ;
    dcterms:type "PoeticWork" ;
