adi:mvsu3LxrTPw8 a rdfs:Resource ;
    rdfs:label "Io so che ti conturbi del mio duolo" ;
    <> adi:8cwGVT3ZREMt,
        adi:FSsfkMyDLbzE,
        adi:cxsSo6EFGddg ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Io so che ti conturbi del mio duolo,
et io del tuo dolor morir mi sento,
Tu zerbin mio, pur ti lamenti solo,
et io sala mi doglio, et mi lamento.
Tu non hai di piacer alcun consuolo,
et io quetar non posso un sol momento,
Talché se tu zerbin mio pati un'hora
io mille volte il dì convien ch'io mora.""" ;
    dc:subject adi:8sSx8HhcDxv6,
        adi:TRHMAMaRfnLP ;
    dcterms:type "PoeticWork" ;
