adi:GFLDn7xMjXym a rdfs:Resource ;
    rdfs:label "Oh lagrime, ch'ad arte" ;
    <> adi:Fas4LiyE5uzU,
        adi:UpNUpRqtonTK ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Oh lagrime, ch'ad arte
Ho tante volte sparte in questo Rio,
Lagrime in cui s'asconde il foco, ond'io
MI struggo a parte, a parte
Quando talhor bagnate
Le delicate membra
Di colei, che del Ciel Diva rassembra
Dite lagrime ingrate
Perché de l'amor mio non l'infiammate?""" ;
    dc:subject adi:3FmSxcCP5CUS,
        adi:VFabTiMFEU5U ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F000380000101_PPPP00011000C> ;
    dcterms:type "PoeticWork" ;
