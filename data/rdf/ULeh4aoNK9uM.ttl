adi:ULeh4aoNK9uM a rdfs:Resource ;
    rdfs:label "Penetra con l'acuto alto intelletto" ;
    <> adi:QzFWBAu4Ku5H,
        adi:dXHZMmpg7CAi ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Penetra con l'acuto alto intelletto,
Da le cagion primiere a le seconde,
Che producon tra noi diverso effetto,
Con qualitati, e sterili, e feconde,
Che con vario del ciel corso, & aspetto,
Dan le fortune averse, e le feconde,
E così de le stelle il lume, e'l moto,
E di natura l'operar l'è noto.""" ;
    dc:subject adi:8Y6NAvRmdtq6,
        adi:mXh2Rsv82eCY ;
    dcterms:type "PoeticWork" ;
