adi:BvR7Sf5a4FUs a rdfs:Resource ;
    rdfs:label "Canto la gran Pietà del Capitano" ;
    <> adi:hLjmox5uXSAo,
        adi:homwwRtTfRTq,
        adi:iAn5hb6SChbm ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Canto la gran Pietà del Capitano,
Che l'aspra morte vendicò di Christo,
Quella Pietà, ch'a lui resse la mano
Mentre fea di Sion l'altero acquisto;
Allor c'osò di far oprarla in vano
Del mondo, e di Stan l'inganno misto
Permettendo del Ciel gli ordini Santi
Per più punir gli Israeliti erranti.""" ;
    dc:subject adi:d6D6vnCgLE5s ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P2551 adi:NtX3nd34H3Wn .

