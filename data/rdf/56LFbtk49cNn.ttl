adi:56LFbtk49cNn a rdfs:Resource ;
    rdfs:label "Chiuso in angusta parte Augusto parto" ;
    <> adi:HjhtUu9o8iuQ,
        adi:aZzwyDRHy9pS ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """CHiuso in angusta parte Augusto parto,
Non starai, che lodato
Da l'ingegni più rari
Andrai col Tempo al pari,
Ovunque Febo snoda il crin aurato,
Come nascosto, come
Privo sarà di nome,
Chi tenta altrui scuoprire
quanto può mai celar l'arte nel dire?
Né palesati suoi secreti l'Arte
Scoprirà te secreto in ogni parte.""" ;
    dc:subject adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
