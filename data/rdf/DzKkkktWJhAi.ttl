adi:DzKkkktWJhAi a rdfs:Resource ;
    rdfs:label "Dunque può star con barbara fierezza" ;
    <> adi:a3fxbFBpFjK2,
        adi:exrSSpj73NMW ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Dunque può star con barbara fierezza
Angelica bellezza?
Dunque di sì bel viso
Barbaro è'l paradiso?
Barbara quella man quella favella
Così soave, e bella
BARBARA a torto il mondo hoggi vi chiama
Barbaro è chi non v'ama.""" ;
    dc:subject adi:FawktbqjQdSF ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/034380000101_PPPP00148700C> ;
    dcterms:type "PoeticWork" ;
