adi:d5nkT3D8oW4S a rdfs:Resource ;
    rdfs:label "Se nel tempo de' fiori" ;
    <> adi:9ENdykkNtf6X,
        adi:AqfSVRY3KtFh ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Se nel tempo de' fiori
Cose procude il suo fecondo ingegno,
Onde tu arrivi al segno
Di vera gloria, e d'immortali onori;
Sicché Roma t'ammiri, e lodi il Franco,
E coll'Ibero audace
T'innalzi al Ciel, chi non pudica face
T'accese il lato manco;
Paolo abbastanza non lodate mai,
Nella stagion de' frutti, e che farai?""" ;
    dc:subject adi:duqiuAVT6ZNg ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:BQRZFgW6wAyq,
        adi:P5ipTFsK5dJG ;
    ns1:P2551 adi:FPYzaHuDcPWK,
        adi:YZkrDgDqrsaF .

