adi:XvRQbPP53gPK a rdfs:Resource ;
    rdfs:label "Come di voi più bella" ;
    <> adi:A7voABhkf6Td,
        adi:eCnHxfYfKQbf ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Come di voi più bella
Non è, né fu, né fia
Donna mortal giamai
Così la fiamma mia
È senza pari anch'ella;
Ma più seriano assai
Queste due cose extreme,
Se fosser note, e ben d'accordo insieme.""" ;
