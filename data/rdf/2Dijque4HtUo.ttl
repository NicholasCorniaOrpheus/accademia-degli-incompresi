adi:2Dijque4HtUo a rdfs:Resource ;
    rdfs:label "Colma di fasto, io me ne già cantando" ;
    <> adi:ZmhzcSbPoocH,
        adi:ke7Y8iiuR8Rg ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Colma di fasto, io me ne già cantando
Lungo un fiorito colle;
E quasi (oh mia sciochezza,)
Godea di questa mia frale bellezza;
Quando frai l'herba molle
Vidi languir un fiore
Privo del suo vital soav'humore.
E conobbi, che tale
Era beltà mortale.""" ;
    dc:subject adi:3ruLTSyv8VeY,
        adi:7grdEZcwLAfB ;
    dcterms:type "PoeticWork" ;
