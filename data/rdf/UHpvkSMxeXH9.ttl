adi:UHpvkSMxeXH9 a rdfs:Resource ;
    rdfs:label "La verginella è simile alla rosa" ;
    <> adi:3tBDveUQba76,
        adi:GdXWhx79h26y ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """La verginella è simile alla rosa,
Ch'in bel giardin su la nativa spina
Mentre sola e sicura si riposa,
Né gregge né pastor se le avicina;
L'aura soave e l'alba rugiadosa,
L'acqua, la terra al suo favor s'inchina:
Gioveni vaghi e donne inamorate
Amano averne e seni e tempie ornate.""" ;
    dc:subject adi:ULLBEJNmWLfc ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F018390000101_PPPP00015400C>,
        <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=31093> ;
    dcterms:type "PoeticWork" ;
