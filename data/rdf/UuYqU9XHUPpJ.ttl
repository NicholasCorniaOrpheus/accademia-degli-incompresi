adi:UuYqU9XHUPpJ a rdfs:Resource ;
    rdfs:label "Ma di che debbo lamentarmi ahi lassa" ;
    <> adi:3tBDveUQba76,
        adi:GdXWhx79h26y ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Ma di chi debbo lamentarmi, ahi lassa,
Fuor che del mio desire irrazionale?
Ch'alto mi leva, e sì ne l'aria passa,
Ch'arriva in parte ove s'abbruggian l'ale;
Poi non potendo sostener, mi lassa
Dal ciel cader: né qui finisse il male;
Che le rimette, e di novo arde: ond'io
Non ho mai fine al precipizio mio.""" ;
    dc:subject adi:dR7sSTMz4jjt ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F019830000101_PPPP00015400C>,
        <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=26619> ;
    dcterms:type "PoeticWork" ;
