adi:GKkTnt9ZK66N a rdfs:Resource ;
    rdfs:label "Ama, ben dice Amore" ;
    <> adi:2hzh3As9hqrE,
        adi:54b5UuCREMA4,
        adi:ZmhzcSbPoocH ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """AMA, ben dice Amore,
Gli occhi, il viso, le chiome
Di questa Dea; ch'angelica beltate
Non sta senza pietate.
Ma, lasso, il fero nome
Par che nel cor mi dica,
Fuggi d'Amor, e di pietà nemica
Barbara Donna, che gli amanti ancide;
Poi li burla, e sen'ride.""" ;
    dc:subject adi:duqiuAVT6ZNg ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/034300000101_PPPP00148700C> ;
    dcterms:type "PoeticWork" ;
