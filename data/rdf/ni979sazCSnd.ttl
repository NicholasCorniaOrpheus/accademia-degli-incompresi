adi:ni979sazCSnd a rdfs:Resource ;
    rdfs:label "Mi duol non haver stile" ;
    <> adi:53AwWJ6fYC5v,
        adi:Pgvz7HXbEsUg,
        adi:RE3XAqvEyiZM ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Mi duol non haver stile
Uguale a i meriti vostri
DOMENICHI gentile,
Acciò potessi in parte
Così, com'ho il desio
Dirne una qualche parte:
Ma non potendo più vi dono il core,
E vi prego a tener a mente ch'io
Sì come mio maggiore
Vi riverisco, e bramo farvi honore.""" ;
    dc:subject adi:DHTHVpQnvYLr,
        adi:ndYmAKz88N5Q ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F055200000101_PPPP00042300C> ;
