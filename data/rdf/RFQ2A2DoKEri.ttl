adi:RFQ2A2DoKEri a rdfs:Resource ;
    rdfs:label "Amor scorta mi fosti a bell'imprese (Manara)" ;
    <> adi:BUv5mtCCibRc,
        adi:ERMFWdTyYMqf,
        adi:kkgq8HBT4zY9,
        adi:mDfYSAMyzr24 ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Amor scorta mi fosti a bell'imprese
Quando da terra in fin al ciel m'alzasti
Però ringrazio te signor cortese
Ch'a sì gran pregio gli occhi miei levasti
Alor che senz'oltraggio e senz'offese
Cose leggiadre nel mio cor mandasti""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/018700000010101_000000146300C> ;
    dcterms:type "MusicComposition" ;
