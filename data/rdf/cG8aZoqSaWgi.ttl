adi:cG8aZoqSaWgi a rdfs:Resource ;
    rdfs:label "Non temete più, amanti" ;
    <> adi:B5dDXV6qVG2p,
        adi:g3KbkbPs6i3L ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Non temete più, amanti,
Che vi saetti Amore,
Che vota ha la faretra nel mio core:
Né del suo foco alcun habbia sospetto,
Ch' arso havendomi il petto
Ascosa ha la facella
Né i raggi del mia lucente stella.""" ;
