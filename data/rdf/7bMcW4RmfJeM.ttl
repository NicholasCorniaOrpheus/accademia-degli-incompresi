adi:7bMcW4RmfJeM a rdfs:Resource ;
    rdfs:label "Misera a chi mai più creder debb'io" ;
    <> adi:3tBDveUQba76,
        adi:GdXWhx79h26y ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Misera a chi mai più creder debb'io?
Vo dir ch'ognuno e perfido e crudele:
Se perfido e crudel sei Ruggier mio
Che sì pietoso tenni e sì fedele,
Qual crudeltà qual tradimento rio
Unqua s'udì per tragiche querele
Che non trovi minor se pensar mai
Al mio merto e al tuo debito vorrai?""" ;
    dc:subject adi:UKk9xKyR5owm ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F019870000101_PPPP00015400C>,
        <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=26619> ;
    dcterms:type "PoeticWork" ;
