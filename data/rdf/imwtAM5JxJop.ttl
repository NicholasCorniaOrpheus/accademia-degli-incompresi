adi:imwtAM5JxJop a rdfs:Resource ;
    rdfs:label "Altri pur dica. Che ne' falsi chiostri" ;
    <> adi:RidaxpYHRDz3,
        adi:nxtaeZb4ETk2 ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Altri pur dica. Che ne' falsi chiostri,
Ove il terrore ha rigido ricetto,
Traggan la vita portentosi mostri
Di fiere luci, e di mortale aspetto,
Che, se di rimirar gli aurori, e gli ostri
Del sen, del volto tuo non m'è disdetto,
Altro ridir non puon quest'occhi miei,
Se non, che di bellezza un mostro sei.""" ;
    dc:subject adi:FawktbqjQdSF,
        adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P180 adi:LBUMoVayqW8X,
        adi:aHgkm4kqQFXB ;
    ns1:P2551 adi:NtX3nd34H3Wn .

