adi:SipPqefNjwik a rdfs:Resource ;
    rdfs:label "Oh dolce servitù, dolce tormento" ;
    <> adi:MZhwN3rRpy8x,
        adi:VGVHbg5uSE8V ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Oh dolce servitù, dolce tormento,
Oh dolci lacci miei, dolci catene,
Oh dolcissime pene;
Che in questo amaro amor dì e notte sento.
Io non so già come possibil sia
Che da radice amara
Sì dolce nasca la dolcezza mia:
Ma io vo' pur dir per cosa vera e chiara
Che l'impossibil sol d'amor s'impara.""" ;
    dc:subject adi:FawktbqjQdSF,
        adi:LUkQiYzJMHtq ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F043040000101_PPPP00068900C> ;
    dcterms:type "PoeticWork" ;
