adi:7Bnx4ZvAsPSd a rdfs:Resource ;
    rdfs:label "Ma disteso ed eretto il fero Argante" ;
    <> adi:MyN8HshJ2LaN,
        adi:YvLbpbXURbTT ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Ma disteso, & eretto il fero Argante  
Dimostra arte simile, atto diverso.  
Quanto egli può va co'l gran braccio inante, 
E cerca il ferro no, ma il corpo averso,
Quel tenta aditi novi in ogni instante.
Questi gli ha il ferro al volto ogn'hor converso.  
Minaccia, e intento a proibirgli stassi  
Furtive entrate, e subiti trapassi.""" ;
    dc:subject adi:86Q2aWNHHazc ;
    dcterms:identifier <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=35264> ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:9NZf7yFeJSxK,
        adi:iYYfa4mHSLTk ;
    ns1:P2551 adi:FPYzaHuDcPWK .

