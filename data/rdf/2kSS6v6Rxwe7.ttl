adi:2kSS6v6Rxwe7 a rdfs:Resource ;
    rdfs:label "Vibrate altere Donne a'sen che tardi" ;
    <> adi:YYFRNeCKx9AL,
        adi:fXurj2BzALG4 ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Vibrate altere Donne a' sen che tardi
Conosciuti han di voi l'eterno pregio,
In vece d'armi gl'amorosi sguardi;
E portate di lor superbo fregio
Io perché nullo indugio a me ritardi,
Vittoria eccelsa, feritore egregio
Ne' vaghi volti vostri il tempo, e l'armi
Sceglio, de l'aspra ingiuria a vendicarmi.""" ;
    dc:subject adi:duqiuAVT6ZNg,
        adi:o2i89qrxS3XR ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:M78kPRCB9pow,
