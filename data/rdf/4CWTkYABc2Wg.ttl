adi:4CWTkYABc2Wg a rdfs:Resource ;
    rdfs:label "La luce occhi miei lassi" ;
    <> adi:4fam9RTzpsG4,
        adi:fYFVfFsPJGny ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """La luce occhi miei lassi
Che dava luc'a voi 
Fa giorno ad altri
oscura notte a noi
Ond'io sovente canto
Così va ch'in altrui pon fede tanto.""" ;
    dc:description "There seems to be any poetry collection including this poem by Molza, except from the madrigal by Primavera." ;
