adi:BCCyfMTvSZVM a rdfs:Resource ;
    rdfs:label "Le donne antique hanno mirabil cose" ;
    <> adi:3tBDveUQba76,
        adi:GdXWhx79h26y ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Le donne antique hanno mirabil cose
Fatto ne l'arme e ne le sacre Muse
E di lor opre belle e gloriose
Gran lume in tutto il mondo si diffuse:
Arpalice e Camilla son famose
Perché in battaglia erano esperte et use
Sapho e Corinna perche furon dotte
Splendono illustri, e mai non veggon notte.""" ;
    dc:subject adi:jSo2wG8h9SDa ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/019220000101_PPPP00015400C> ;
    dcterms:type "PoeticWork" ;
