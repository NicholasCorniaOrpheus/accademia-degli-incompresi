adi:nGqHT83LQWFh a rdfs:Resource ;
    rdfs:label "D'ogni amorosa frode" ;
    <> <https://nicholascorniaorpheus.github.io/accademia-degli-incompresi/entity/KpypwymbGp3c]>,
        adi:exrSSpj73NMW ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """D'ogni amorosa frode
V'affida il vostro nome,
Quasi di ricca pianta angue custode;
Che sol ch'altri vi nome,
Oh BARBARA OH GUERRIERA.
Trema, e s'audace pur vi chiama, e spera
Spera il suo danno, e chiama infero carme
La crudeltà con l'arme.""" ;
    dc:subject adi:ndYmAKz88N5Q ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/034380000101_PPPP00148700C> ;
    dcterms:type "PoeticWork" ;
