adi:7LEQYNK3m5Yx a rdfs:Resource ;
    rdfs:label "Alma mia fiamm'et donna (Bargonio)" ;
    <> adi:3KxURtKJVxAF,
        adi:HAVtemqRko2X,
        adi:LeNVLHNHKPVp,
        adi:Rg48ktvfYvix ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Alma mia fiamm'et donna
S'io veggio ogni mio ben nel vostro viso
Io dico ch'ivi sol è il paradiso.
E se gli è pur altrove
Debb'esser un essempio da voi tolto
Et è bel quando vien dal vostro volto.""" ;
    dc:subject adi:TfTjBsLkYTWn ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F009610000010101_000000020800C> ;
    dcterms:type "MusicComposition" ;
