adi:gGCKsZw9yCCi a rdfs:Resource ;
    rdfs:label "Voi che a gl'aringhi miei dolci contese" ;
    <> adi:6PtpfEAH4kyX,
        adi:GdXWhx79h26y,
        adi:Ran6edubGcts ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Voi che a gl'aringhi miei dolci contese
Ma di fero velen sovente armate,
Aman i Cavallier con Donne accese
Di sdegno haveste a' merti vostri ingrate;
Vedeste al fin, che di superbe offese,
Onde languisce il cor fur disarmate;
E così amici, in cari nodi avvinti;
Non conosceste o vincitori, o vinti.""" ;
    dc:subject adi:KuorvRGvXbTz,
        adi:Z6udgtgZac9G ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
