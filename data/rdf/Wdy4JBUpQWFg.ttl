adi:Wdy4JBUpQWFg a rdfs:Resource ;
    rdfs:label "Oh dolce mia nemica" ;
    <> adi:MZhwN3rRpy8x,
        adi:VGVHbg5uSE8V ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Oh dolce mia nemica,
Poiché l'alto amoroso mio desire
Non volete, ch'io dica:
Io no'l vo dir; ma questo dir vorrei;
Che homai i dolori miei
Veder vorrei finire;
Pur se voi non volete io no'l vo dire.""" ;
