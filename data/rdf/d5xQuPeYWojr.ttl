adi:d5xQuPeYWojr a rdfs:Resource ;
    rdfs:label "Se ne le Sfere tu, Se nel Profondo" ;
    <> adi:7co2fT7Qfby2,
        adi:BVavFPBEeQRA,
        adi:fwobE2DWRXRY ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Se ne le Sfere tu, Se nel profondo
Sei Terra fatta aerea in denso Velo,
Aria disciolta in Foco, e tutta pondo,
Foco, ch'è tutta Forma anche nel gelo:
Se nel Cielo sei l'Anima del Mondo,
Se nel Mondo lo Spirito del Cielo,
Dimmi tu, come mai qui l'arte impetra
D'haverti in polve, e d'indurirti in pietra?""" ;
    dc:subject adi:ZfsD5EcdZsxp,
        adi:jpEmjHi9Ym4c ;
    dcterms:type "PoeticWork" ;
