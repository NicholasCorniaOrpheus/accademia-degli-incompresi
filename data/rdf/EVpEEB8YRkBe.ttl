adi:EVpEEB8YRkBe a rdfs:Resource ;
    rdfs:label "Canta Urania la parte" ;
    <> adi:BVmVM3rL2WcH,
        adi:BwRaqPWUAJzz ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Canta Urania la parte
Acuta, & io la grave
Il canto insieme unito è più soave;
Essa con mille fughe e mille giri
Va dolce in me scherzando,
Io scherzo e faccio in lei
Mille mutation, mille sospiri;
Ella dice cantando:
La voce acuta acuti ho gli occhi miei;
Et io dico: in me tanto,
Quanto è grave l'amor, è grave il canto.""" ;
    dc:subject adi:bHJG3dg7VrRb ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/010780000101_PPPP00245600C> ;
    dcterms:type "PoeticWork" ;
