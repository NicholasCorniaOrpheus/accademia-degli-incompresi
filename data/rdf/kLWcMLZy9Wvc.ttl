adi:kLWcMLZy9Wvc a rdfs:Resource ;
    rdfs:label "Madonna hor che direte" ;
    <> adi:FJaARznhrRx9 ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Madonna, hor che direte,
Ch'n tutto l'amor mio perdut'havete
Voi pensavate sol darmi tormento
E pascermi di vento
Di parolette ardite,
Né mai farmi contento?

No, no quel foco in me del tutto è spento
Deggio aprirvi il mio cor madonna udite
Poiché sì cruda sete
In tutto l'amor mio perduto havete.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/001390000101_000000087200> ;
    dcterms:type "PoeticWork" ;
