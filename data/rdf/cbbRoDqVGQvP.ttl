adi:cbbRoDqVGQvP a rdfs:Resource ;
    rdfs:label "Io canto chelle forze, e chelle prove" ;
    <> adi:7b7Bz2vfVZsa,
        adi:EYZsPUT7fJ7Z,
        adi:axZuicfz2UNJ ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """IO canto chelle forze, e chelle prove,
Che fecero cierte hoummene valiente,
Chiù d'Orlando, chiù d'Ercole, e de Giove
Anze a paro de chiste non so niente,
E dico ancora comme fuieno nove.
Chiste, e se steano a spizzolà li diente,
E feceno'ntrà lloro no' consiglio
De ijre a conquistare lo Cerriglio.""" ;
    dc:subject adi:Z6udgtgZac9G ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:gqVw8qPNVyAR ;
    ns1:P2551 adi:NtX3nd34H3Wn .

