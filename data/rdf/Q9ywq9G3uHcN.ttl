adi:Q9ywq9G3uHcN a rdfs:Resource ;
    rdfs:label "Scherza nel canto e piace" ;
    <> adi:BVmVM3rL2WcH,
        adi:LWqMey9cVuah ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Scherza nel canto e piace,
Madonna hor poggia hor scende,
Hor con veloce ed hor con lenta voce,
allett' e sface ,
Escon le note care,
Da belle labbia ond' ard' ogn' hor si vago,
Ch'al udir ch'al mirar due sensi appago,
Oh dolce variare,
Pago in due modi hor sono,
Godon gl'occhi ai Rubin, gl'orecchi al suono.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/011470000101_PPPP00245600C> ;
    dcterms:type "PoeticWork" ;
