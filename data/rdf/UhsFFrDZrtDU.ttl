adi:UhsFFrDZrtDU a rdfs:Resource ;
    rdfs:label "Da l'humile verme" ;
    <> adi:DBbuJixjJLjY,
        adi:atJRiaBCbdYr ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Da humil verme tra l'herbe rimote
Ne la sinistra man fu punto Amore,
E sentendo il dolor, che lo percote,
Pallid, essangue, & perso ogni colore,
Gridava a Citherea hor come pote
Ferir breve animal con tal dolore?
Disse Vener ridendo, taci hormai,
E tu, che picciol sei, che piaghe fai?""" ;
    dc:subject adi:TfTjBsLkYTWn ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F029760000101_PPPP00002000C> ;
    dcterms:type "PoeticWork" ;
