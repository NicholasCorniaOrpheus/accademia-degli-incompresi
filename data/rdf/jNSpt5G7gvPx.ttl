adi:jNSpt5G7gvPx a rdfs:Resource ;
    rdfs:label "Dicesti anima mia" ;
    <> adi:VjjrkrDYaLND,
        adi:dZAxHiTJuqCF ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Dicesti anima mia
Ch'ardi per me d'Amore
Sol con le labbra
O col profondo core
Ah non sia mai ch'io il creda
Finché dell'amor tuo segno non veda
Vuoi che sicuro io sia
Che siano i detti tuoi ﬁdi e veraci
Sian testimoni e guiramenti i baci.""" ;
