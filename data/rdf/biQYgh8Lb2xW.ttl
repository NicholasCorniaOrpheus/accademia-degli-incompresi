adi:biQYgh8Lb2xW a rdfs:Resource ;
    rdfs:label "Amor tu causi tutt'il penar mio" ;
    <> adi:42hnQ3TVouFv,
        adi:4qz9ARSJbUuJ ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Amor tu causi tutto il penar mio:
Tu mi fai il torto, e non colei ch'io adoro;
Che se tu dessi effetto al mio desio,
Havrei ne i danni pur qualche ristoro.
Ma tu se' ingiusto & lusinghiero Iddio;
E sei cagion, che per amare io moro.
Che se il mio stato con giustitia guardi,
A pena havuto io n'ho parole & sguardi.""" ;
    dc:subject adi:knKLHuWASYk4 ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P180 adi:MfBWzgNTqiki ;
    ns1:P2551 adi:NtX3nd34H3Wn .

