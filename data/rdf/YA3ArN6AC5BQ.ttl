adi:YA3ArN6AC5BQ a rdfs:Resource ;
    rdfs:label "Ecco'l mio vivo sole (Agostini)" ;
    <> adi:3ybFxsvJusaH,
        adi:9dFYyM84hbdJ ;
    pdc:poeticType adi:DJS8XPPRYbXP ;
    pdc:text """Ecco'l mio vivo sole,  
Anzi mio chiara luna,  
Cinta d'ardenti rai tutta riluce,  
E chiara più del sole,  
Bianca più de la luna,  
Mostra benigna sua serena luce,  
Né più quel sol ne quella luna luce,  
Ma la mia chiara e bella,  
Sparir fa il sol la luna e qual sia stella.""" ;
    dc:subject adi:MVesHQPbVg5X ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/092810000020101_000000002400C> ;
    dcterms:type "MusicComposition" ;
