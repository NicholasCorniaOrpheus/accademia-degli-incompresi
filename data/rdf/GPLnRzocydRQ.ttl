adi:GPLnRzocydRQ a rdfs:Resource ;
    rdfs:label "Infelice Signor, hor questo è'l merto" ;
    <> adi:NGrxmrXecZ5w,
        adi:mtmLGiiqGNUj ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Infelice Signor, hor questo è'l merto,
Che della tua bontà fra noi riporti,
Per aprirci il camin scosceso, & erto
Di gire al Ciel, quai pene, ahi non sopporti?
Perché mostrasti il tuo potere aperto,
Sanando gl'egri, e ravvivando i morti,
Sarai costretto dallo stuol feroce
Lasciar il corpo essanimato in Croce.""" ;
    dc:subject adi:4dyo9zXijchN,
        adi:GJNhc2VqDoFL ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:kcWr3rLLCUsP ;
    ns1:P2551 adi:FPYzaHuDcPWK .

