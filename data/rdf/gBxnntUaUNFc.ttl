adi:gBxnntUaUNFc a rdfs:Resource ;
    rdfs:label "Quanti son poi, che divenuti amanti" ;
    <> adi:d564otbkr4yr,
        adi:jZuvVuSH7U3b ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Quanti son, poi, che divenuti amanti
Di due begli occhi, e d'un leggiadro viso,
Si pascon sol di dolorosi pianti,
Da se stessi tenendo il cor diviso,
Né gioia né piacer sono bastanti
Trar lor del petto, se non finto riso,
E se lieti tal'hor si mostran fuori,
Hanno per un piacer, mille dolori.""" ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:PkJjQdNqm3ok,
        adi:Suq86ApyHSzQ,
        adi:UZuCbSwwuwLY ;
    ns1:P2551 adi:FPYzaHuDcPWK .

