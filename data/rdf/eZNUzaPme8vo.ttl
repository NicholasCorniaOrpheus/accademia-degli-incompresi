adi:eZNUzaPme8vo a rdfs:Resource ;
    rdfs:label "S'è ver quel che si legge (Martoretta)" ;
    <> adi:TmP2FaKYdJii,
        adi:V6FTS9bq4reT,
        adi:jj33YgYDCDzd ;
    pdc:text """S'È ver quel che si legge
L'amante nell'amata si trasforma
Presa l'amata forma
Non sono più quel ch'era ma son voi 
Se cosa dunqu'ho detto che v'annoi
Non incolpate donn'il parlar mio
Che la dicesti voi non la diss'io.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F263400000010101_000000134800C> ;
