adi:5DNfHWgjqYed a rdfs:Resource ;
    rdfs:label "Fate in me quel si puote o cieli o sorte" ;
    <> adi:NdoMgsS6yGTo,
        adi:WsQJYjxufGKj,
        adi:kFghMqXMQGVb ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Fate in me quel si puote o cieli o sorte;
Et fiammi contra tutti i vostri inganni;
Che un voler manterrò fino a la morte,
Un cor & un pensier fra tanti affanni.
Starò nell'esser mio costante e forte,
Così ne i primi, qual ne gli ultimi anni:
Anzi morrò, se ben il ver s'estima,
Prima che colpo di fortuna, o prima.""" ;
    dc:subject adi:4yA7EuAeTMCw,
        adi:ddyPTXYyiFzq ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:ipSJVTEhEkc6 ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
