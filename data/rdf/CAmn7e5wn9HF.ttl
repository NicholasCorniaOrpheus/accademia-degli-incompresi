adi:CAmn7e5wn9HF a rdfs:Resource ;
    rdfs:label "Voi, che né a pianto mai, Donna crudele" ;
    <> adi:6i2dMd6jYqCG,
        adi:UWctEc65LxYY ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """VOi, che né a pianto mai, Donna crudele,
Né a sospir, né a querele
Credeste il mio martire
Lo crederete, ahi lasso,
Vedendomi morire?
Oppur quel cor di sasso,
A l'incendio d'Amor sempre più forte,
Goderà lieto ancor de la mia morte?
Ahi presto almen di pace il cor vi spoglie
Crudel, ch'havran pur fin l'aspre mie doglie.""" ;
    dc:subject adi:ddyPTXYyiFzq ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F006370000101_000000181100C> ;
    dcterms:type "PoeticWork" ;
