adi:ixZn2ZSnYiyw a rdfs:Resource ;
    rdfs:label "Amar un sol amante è vero amore" ;
    <> adi:MZhwN3rRpy8x,
        adi:VGVHbg5uSE8V ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Amar un sol amante è vero amore;
Et d'alma gentil nasce,
Ma chi di più l'ingorda voglia pasce
Quest'è lussuria poi, quest'è furore:
Voi sguardi, & risi, pur date a ciascuno:
Ma io dico in due parole;
Amate un solo; & ch'io sia poi quel uno;
In fine haver un sol amor si vole;
Ch'a noi ci basta un Dio, ci basta un Sole:""" ;
    dc:subject adi:HdQB3CYz2ig3 ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F042510000101_PPPP00068900C> ;
    dcterms:type "PoeticWork" ;
