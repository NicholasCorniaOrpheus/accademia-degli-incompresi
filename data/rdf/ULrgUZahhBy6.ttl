adi:ULrgUZahhBy6 a rdfs:Resource ;
    rdfs:label "S'è ver quel che si legge (Lando)" ;
    <> adi:9FW3RNWgLo6H,
        adi:QG8DUy9nrgZ9,
        adi:hMZuHnuTemgu ;
    pdc:text """Se'l ver quel che si legge
che l'amante in quel ch'ama si trasforma
presa l'amata forma
Io non so quel ch'i m'era ma son voi 
se cosa dunque ho detto che v'annoi
Non incolpate donna il parlar mio
che la diceste voi non la diss'io.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F263400000010101_000000134800C> ;
