adi:3ymKGaAGZ6fv a rdfs:Resource ;
    rdfs:label "Ben giunga, oh saggia Diva" ;
    <> adi:QHMHMRazjvvf,
        adi:QJyQvn86nmBt,
        adi:msaShVwusGue ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Ben giunga, oh saggia Diva,
De le Muse sorella, in fra le nove
Figlie del sommo Giove
La tua presenza al sacro monte ombroso,
Che de' Cigni al riposo
ben si convien là dove
Riga Hippocren la sempreverde riva
Tra gli allori l'oliva.""" ;
    dc:subject adi:99cprNhigxtK,
        adi:Jn2SrMsbo8RA ;
    dcterms:identifier <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=17016> ;
    dcterms:type "PoeticWork" ;
