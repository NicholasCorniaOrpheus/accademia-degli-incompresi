adi:2KTWZWEaqaaa a rdfs:Resource ;
    rdfs:label "Donna se di fier Orso" ;
    <> adi:McrW73AUvkY7,
        adi:XMWeuXsQK4ED,
        adi:e6n9NhgGxtDK ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """DONNA se di fier ORSO
Havete il nome è ben ragion che sia
A quello somigliante il vitio, e'l morso,
Ma se spietata, e ria
Morder un BASILISCO vi credete
Cieca voi non vedete,
Che s'in voi sono denti, ed ugnia trista
Egli ha velen nel fiato, e ne la vista?""" ;
    dc:subject adi:9w8iYcz955Kd,
        adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
