adi:Sio7N3N8QfxC a rdfs:Resource ;
    rdfs:label "Chi vive senza mai sentir riposo" ;
    <> adi:D7Lfbq5eiaTi,
        adi:RPt3AF9FDvgd ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Chi vive senza mai sentir riposo
Lontano da la dolce amata vista,
Chi a se stesso divien grave, e noioso
Sol per un guardo, o una parola trista,
Chi da un novo rival fatto geloso,
Quasi a par del morir si duol'e attrista,
Chi si consuma in altre varie pene,
Più spesse assai de le minute arene.""" ;
    dc:subject adi:H8pNPRSuos4Q ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
    ns1:P180 adi:JBikyUiJZWVH,
        adi:Q3VtFUAxVKyf ;
    ns1:P2551 adi:emwSSkhQpsBS .

