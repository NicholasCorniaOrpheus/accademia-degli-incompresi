adi:Co9fJ3AXQPVq a rdfs:Resource ;
    rdfs:label "Musa che meco in basso stil cantasti" ;
    <> adi:6RCgZiH6GJMA,
        adi:E5iRLUFCaaJC ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Musa che meco in basso stil cantasti,
Al dolce canto di garuli Augelli,
Alla grat'ombra l'aura fermasti
El mormorio di limpidi Ruscelli:
Scherzi vari d'Amor, honesti, e casti,
Di Ninfe, e di Pastor leggiadri, e belli;
S'audace hora a cantar sì alte imprese
M'accingo, di favor siemi cortese.""" ;
    dc:subject adi:ZfsD5EcdZsxp,
        adi:kVrAkrexneyx ;
    dcterms:type "PoeticWork" ;
