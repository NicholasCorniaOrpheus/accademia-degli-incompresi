adi:5xNP2ajjoXtt a rdfs:Resource ;
    rdfs:label "La bella Bradamante che se stessa (Martoretta)" ;
    <> adi:THDdx5np8gBo,
        adi:bdRLRxnHkEJT,
        adi:ipSYHRQgqztR ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """La bella Bradamante che se stessa
Non tant'amava quant'il suo Ruggiero
Vedendolo dubbioso a la promessa
Che gl'era per lei fatta d'amor vero
Una lettera gli scriss'accio per essa
Riconoscesse falso il suo pensiero
Et eran tai parole in quel bel foglio
Ruggier qual sempre fui tal esser voglio.""" ;
    dc:subject adi:GhA3XmpeZfqx ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F133850000010101_000000133700C> ;
