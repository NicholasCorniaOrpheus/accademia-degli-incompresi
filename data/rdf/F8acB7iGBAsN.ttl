adi:F8acB7iGBAsN a rdfs:Resource ;
    rdfs:label "Non teme oh Dea di questa età gentile" ;
    <> adi:PndEj8FtSonb,
        adi:XFzV5zn8KYUy,
        adi:jAAB8FezF2Df ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Non teme oh Dea di questa età gentile
La fabrica immortal del Tempio vostro,
Quanto offende la nostra; e ogni simile
Ad altrui danno, e per essempio nostro,
Folgori, tuoni, e l'immutabil stile
Del tempo crudo, e dispietato monstro;
Sendo i beati suoi fabricatori
Alme, eccellenti, e gloriosi cori.""" ;
    dc:subject adi:Bn5ScQdZ4EM4,
        adi:ZfsD5EcdZsxp ;
    dcterms:type "PoeticWork" ;
