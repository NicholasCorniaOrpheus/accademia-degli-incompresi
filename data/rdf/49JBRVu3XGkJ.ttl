adi:49JBRVu3XGkJ a rdfs:Resource ;
    rdfs:label "Dir male, & dire il ver genera sdegno" ;
    <> adi:SifJFtUcR76e,
        adi:YXSurDyNHSdr ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Dir male, & dire il ver genera sdegno
Sogliono dire gl'ipocriti e Piangioni
chi ben dice, & mal fa di morte è degno
come fanno i cagnacci hipocritoni. 
A buon sotii l'orecchia a grattar vegno
Non a gli adulator, non a poltroni, 
Non è vitio più pregno di veleno 
Ch'ornar di lode, chi di biasmo è pieno.""" ;
    dc:subject adi:iWMn6FHJ2W74 ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:iFXJgwZy2vLK ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    ns1:P2551 adi:NtX3nd34H3Wn .

