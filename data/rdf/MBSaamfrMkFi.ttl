adi:MBSaamfrMkFi a rdfs:Resource ;
    rdfs:label "T'amo, mia vita, la mia cara vita" ;
    <> adi:DNVcUvyBSBo3,
        adi:a3fxbFBpFjK2 ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """T'amo, mia vita, la mia cara vita 
Dolcemente mi dice, e'n questa sola 
Sì soave parola 
Par che trasformi lietamente il core, 
Per farmene signore. 
Oh voce di dolcezza, e di diletto, 
Prendila tosto Amore;
Stampala nel mio petto;
Spiri solo per lei l'anima mia: 
T'AMO MIA VITA, la mia vita sia.""" ;
    dc:subject adi:HdQB3CYz2ig3 ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F034390000103_004600010C> ;
    dcterms:type "PoeticWork" ;
