adi:eh6HMca8AhDF a rdfs:Resource ;
    rdfs:label "S'odono e varie lingue, e personaggi" ;
    <> adi:FseFVcsndDRv,
        adi:Hr9WcLu6ZZUq,
        adi:busj5N7wko8B ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """S'odono e varie lingue, e personaggi
Atti meglio a destar la burla, e'l riso,
Hor con brutte cadute, hor con visaggi,
Hor con mentito adulterato viso.
E (quel, ch'anco è difficile a' più saggi)
Pronto usciva il discorso, ed improviso;
E regolava il subito concetto
La norma di strettissimo soggetto.""" ;
    dc:subject adi:Ye88EjEg6hpa,
        adi:dhsgN9hmFdsq ;
    dcterms:type "PoeticWork" ;
