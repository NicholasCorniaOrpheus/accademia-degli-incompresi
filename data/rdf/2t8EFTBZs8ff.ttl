adi:2t8EFTBZs8ff a rdfs:Resource ;
    rdfs:label "Stella, che fra le stelle" ;
    <> adi:NWnCiX3cyfCg,
        adi:PsKxUAuVhYJe ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Stella, che fra le stelle,
Quasi un Sol siedi, e con duo vivi Soli
Al Sol la luce, & a me il core involi,
Se Tu fra l'altre belle
Fossi o men bella, o più cortese un poco,
Cenerer è tal, che saria ancora foco.""" ;
    dc:subject adi:duqiuAVT6ZNg ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/041210000101_PPPP00117901C> ;
    dcterms:type "PoeticWork" ;
