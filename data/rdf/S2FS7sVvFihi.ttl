adi:S2FS7sVvFihi a rdfs:Resource ;
    rdfs:label "Le donne i cavallier l'arme gli amori" ;
    <> adi:EBMKwsCza3hd,
        adi:XU8S5WyvBShC ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Le donne, i cavallier, l'arme, gli amori,
le cortesie, l'audaci imprese io canto,
che furo al tempo che passaro i Mori
d'Africa il mare, e in Francia nocquer tanto,
seguendo l'ire e i giovenil furori
d'Agramante lor re, che si diè vanto
di vendicar la morte di Troiano
sopra re Carlo imperator romano.""" ;
    dc:subject adi:8GvHmwR26GRn ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:Fgb2i9ph7wYA,
        adi:gHVGjgKjtq6V ;
    ns1:P2551 adi:FPYzaHuDcPWK .

