adi:GhS4fnsNs9Y7 a rdfs:Resource ;
    rdfs:label "Canto l'arme pietose, e'l Capitano" ;
    <> adi:Lv8EW8V8UKXk,
        adi:UJZ7Qau55M9Z ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Canto l'Arme pietose, e'l Capitano,
Che'l gran Sepolcro liberò di CHRISTO:
Molto egli oprò col senno, e con la mano,
Molto soffrì nel glorioso acquisto.
E in van l'Inferno vi s'oppose, e in vano
S'armò d'Asia, e di Libia il popol misto,
Il Ciel gli diè favore, e sotto a i santi
Segni ridusse i suoi compagni erranti.""" ;
    dc:subject adi:SeFHUS9MYJuk ;
    dcterms:identifier <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=35246> ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
    ns1:P2551 adi:emwSSkhQpsBS .

