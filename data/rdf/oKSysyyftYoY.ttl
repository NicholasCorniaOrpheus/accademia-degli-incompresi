adi:oKSysyyftYoY a rdfs:Resource ;
    rdfs:label "Poiché del vostro canto (Agostini)" ;
    <> adi:XtiKQkt7awAq,
        adi:cBJV9SeGc3Sw,
        adi:jPYPYvZuSBLf ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Poiché del vostro canto
Gentil Signora i' vivo,
Fatemi gratia tanto,
Che di quel mai non mi sia fatto nego.
Deh cantate vi prego,
Cantate in cortesia.
Cara la vita mia.""" ;
