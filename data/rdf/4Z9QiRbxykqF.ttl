adi:4Z9QiRbxykqF a rdfs:Resource ;
    rdfs:label "Tal da un impuro Chaos tu sciogli ancora" ;
    <> adi:7co2fT7Qfby2,
        adi:BVavFPBEeQRA,
        adi:fwobE2DWRXRY ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Tal da un impuro Chaos tu sciogli ancora
La purità che in se medesmo serra.
A un Moto Violento escono fuora
Da lui pur anche Acqua, Aria, Foco, e Terra.
Escon rotando, e distillando ogni hora
Gli elementi alterati in lunga Guerra,
Né toran mai pacificati insieme,
Se non puri in vapor, Splendidi in Seme.""" ;
    dc:subject adi:ZfsD5EcdZsxp,
        adi:jpEmjHi9Ym4c ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
