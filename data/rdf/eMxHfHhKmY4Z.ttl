adi:eMxHfHhKmY4Z a rdfs:Resource ;
    rdfs:label "Non è nel mondo tutto (Passetto)" ;
    <> adi:EfY2dL7MpgHY,
        adi:NG59X2AJp46C,
        adi:hj9HyzwqCAFm ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """NOn è nel mondo tutto
in ciel perfett'una felicitade
s'in compagnia non è la libertade
dolce libertà mia
ch'haver la libertà pura e sinciera
ben misero e chi spera
se non advien  che tua mercé lo aiuti 
bellezz'in modo d'haver che sian compiute
Canzon sempre vorrei cantar
di libertà senza la quale 
ogni ben nostro e male
quest'è il summo piacer di piacer mei
quest'è l'ambrosia de gli eterni dei.""" ;
    dc:subject adi:UyJtdV6URXyB ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F172900000010101_000000182900C> ;
