adi:9VnRWdUfwVtU a rdfs:Resource ;
    rdfs:label "Chi può le stelle, o le minute arene" ;
    <> adi:JLv6HZNGtUao,
        adi:Y8fMkvEhyHyo ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Chi può le stelle, o le minute arene,
O tutte annoverar l'istabili onde;
E dir quanto su 'l dorso alto sostiene
Il siluoso Appennin piant', herbe, e fronde.
Dirà quant'io martir sostenga, e pene,
Quante asconda il mio cor piaghe profonde.
Quanti, lunge da voi, mia bella Aurora,
Prieghi, pianti, e sospir vi mandi ogn'hora.""" ;
    dc:description "The author is departed from their lover, who moved on the other side of the Appenines." ;
    dc:subject adi:Bvvit9jGS3mp ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
    ns1:P180 adi:MiEZVRza7UDo,
        adi:SKQKJ7R9NHcd ;
