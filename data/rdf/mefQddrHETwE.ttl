adi:mefQddrHETwE a rdfs:Resource ;
    rdfs:label "Voi scoglio a sostener, novelli Atlanti" ;
    <> adi:6PtpfEAH4kyX,
        adi:Ran6edubGcts ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Voi scoglio a sostener, novelli Atlanti,
Il Ciel de le mie glorie a voi sol lice,
Or che novo furor d'empi Giganti
Guerra crudele al mio bel Regno indice,
A voi ricorro avventurieri amanti
Movete contra lor la mano ultrice;
Io sarò vosco, e feritor preggiati
Di loro farovvi, e vincitor beati.""" ;
    dc:subject adi:KuorvRGvXbTz,
        adi:Z6udgtgZac9G ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
