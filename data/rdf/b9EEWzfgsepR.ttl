adi:b9EEWzfgsepR a rdfs:Resource ;
    rdfs:label "Alma beata e bella" ;
    <> adi:AjNf7Seeiq55,
        adi:EFuUKGrphXjs ;
    pdc:poeticType adi:Mnb2BoNNxo5h ;
    pdc:text """Alma beata e bella,
Che da' legami sciolta
Nuda salisti ne' superni chiostri,
Ove con la tua stella
Ti godi insieme accolta;
E lieta ivi schernendo i pensier' nostri,
Quasi un bel sol ti mostri
Tra li più chiari spirti;
E coi vestigi santi
Calchi le stelle erranti;
E tra pure fontane e sacri mirti
Pasci celesti greggi,
E i tuoi cari pastori indi correggi.""" ;
    dc:subject adi:kVrAkrexneyx ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/025810000101_PPPP00260406> ;
    dcterms:type "PoeticWork" ;
