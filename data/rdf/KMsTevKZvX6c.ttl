    wdt:P870 adi:nKCWTNSaUJQU ;
    skos:altLabel "O beati color; c'hanno duo cori" ;
    ns1:P180 adi:VGUgNmuMpvAd ;
    ns1:P2551 adi:FPYzaHuDcPWK .

