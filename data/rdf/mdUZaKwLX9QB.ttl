adi:mdUZaKwLX9QB a rdfs:Resource ;
    rdfs:label "O bella Dea, che da' celesti giri" ;
    <> adi:au2FAKGHhhNM ;
    pdc:text """O bella Dea, che da' celesti giri
Discesa in terra sei spinta d'amore;
Che già gli spirti eletti infiammati e inspiri,
E vesti il mondo, di novel colore;
Empi di santi affetti, e bei desiri,
A questa schiera Virtuosa i core.""" ;
    dc:subject adi:33fBjU7SLdGj,
        adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:R8gaAppcmFNh ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    ns1:P2551 adi:NtX3nd34H3Wn .

