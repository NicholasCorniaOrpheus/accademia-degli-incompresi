adi:WfsL9zDkdL9u a rdfs:Resource ;
    rdfs:label "Tirrena mia il cui colore agguaglia" ;
    <> adi:23rCvdgVPxoA,
        adi:dbbU5aPBAxvp ;
    pdc:poeticType adi:8cSCusLrr4RD ;
    pdc:text """Tirrena mia, il cui colore agguaglia
Le matutine rose e' puro latte;
Più veloce che damma,
Dolce del mio cor fiamma;
Più cruda di colei che fe' in Tessaglia
Il primo alloro di sue membra attratte;
Sol per rimedio del ferito core
Volgi a me gli occhi, ove s'annida Amore.""" ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/025780001501_PPPP00260406>,
        <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=29300> ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:krJNW7CuZmu4 ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
