adi:hr79ctZf4CzN a rdfs:Resource ;
    rdfs:label "Spent' hai del nostro Oreto, hai morte rea" ;
    <> adi:GSwDHeBQN6dA,
        adi:L8ExepDu7q6Y,
        adi:QebcawKVJxyt ;
    pdc:poeticType adi:nJ46mYz7ym9T ;
    pdc:text """SPENT' hai del nostro ORETO, hai morte rea,
Il più famoso, e chiaro
Huom, che vedesse mai dal cielo stella.
Avara e cieca, e dispietata Dea
Deh come in pianto amaro
Lasciat' hai il Mondo, e tu d'amor rubella
Di così preda bella
Ne vai superba con l'altera fronte,
E di sue merci conte
Ricco n'hai fatto il ciel (grado condegno)
E'n poverito questo nostro Regno.""" ;
    dc:subject adi:bz2ZiUr2xdwm ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:cgc6L4BKvLKt ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
