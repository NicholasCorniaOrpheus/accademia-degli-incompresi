adi:TfkDrEApJ4oF a rdfs:Resource ;
    rdfs:label "Lacci, catene, ceppi" ;
    <> adi:QG8DUy9nrgZ9,
        adi:Up3JPoUhPHLL ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Lacci, catene e ceppi,
Giogo, prigion, saette, fiamme, & gelo,
Mentre mi copre il cielo,
Non mi lasciate un punto senza voi.
Amor fa, quanto poi;
Che benché molto pata, poco il sento;
Sì dolce è la cagion del mio tormento.""" ;
