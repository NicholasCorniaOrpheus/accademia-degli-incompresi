adi:ZJaLzsMk7UBE a rdfs:Resource ;
    rdfs:label "Oh Bellissimo petto" ;
    <> adi:Fas4LiyE5uzU,
        adi:UpNUpRqtonTK ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Oh Bellissimo petto,
Dolce petto amoroso
De l'avido mio sguardo altero oggetto
Per questo caldo humore,
Ond'hor se'rugiadoso
Poiché partir convien rendimi il core.
No no. Fia meglio, ch'io nel duol mi stempre
Pur che'n sì degno albergo ei viva sempre.""" ;
    dc:subject adi:HXwdX5qkqNv6 ;
    dcterms:type "PoeticWork" ;
