adi:o7iQETcHwfNW a rdfs:Resource ;
    rdfs:label "Dolce contrade oh chius'e cheti valli (Patronieri)" ;
    <> adi:LxyeMrhvSzsL,
        adi:MtH5i5tX8ThC ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Dolce contrade oh chiusi e cheti valli
Dov'è il mio sol? pure quinci lontano
Ond'l mio duro piant'ognor rinova
Oh ben nati fioretti bianch'e gialli
Che cor spesso solea la bianca mano
Dove son gl'occhi miei che qui non trovo.""" ;
