adi:CcPTY5cbYfhK a rdfs:Resource ;
    rdfs:label "Quanto mi sia dolore, e grieve affanno" ;
    <> adi:4qz9ARSJbUuJ,
        adi:MUzXCQRBaVpr,
        adi:nogTh57GD9Fg ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Quanto mi sia dolore, e grieve affanno,
Illustrissima mia donna Eleonora
Del vostro breve tempo e lungo danno
Che con fedel consorte io vidi allora
Scemar, ne la più verde età de l'anno,
Quando in più gioia amor l'arco lavora,
Ma lascia il duol che sel mortal suo velo
Giace sotterra l'alma hor viene in Cielo.""" ;
    dc:description "Ottava rima for the premature death of Eleonora Sanseverino." ;
    dc:subject adi:bz2ZiUr2xdwm,
        adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
