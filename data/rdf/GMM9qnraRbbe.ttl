adi:GMM9qnraRbbe a rdfs:Resource ;
    rdfs:label "Chi va lontan da la sua patria, vede" ;
    <> adi:EBMKwsCza3hd,
        adi:XU8S5WyvBShC ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Chi va lontan da la sua patria, vede
Cose, da quel che già credea, lontane;
Che narrandole poi, non se gli crede,
E stimato bugiardo ne rimane:
Che'l sciocco vulgo non gli vuol dar fede,
Se non le vede e tocca chiare e piane.
Per questo io so che l'inesperienza
Farà al mio canto dar poca credenza.""" ;
    dc:subject adi:8fwpHxgNG6ST,
        adi:EhFuVpKyjLFt ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/018540000101_PPPP00015400C>,
        <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=26594> ;
    dcterms:type "PoeticWork" ;
