adi:kk39LcQ7brPV a rdfs:Resource ;
    rdfs:label "L'empio tuo strale Amore" ;
    <> adi:dGUWfMNNCYuo,
        adi:h3THWXv6qB74 ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """L' EMPIO tuo strale Amore,
È più crudo, e più forte
Assai che quel di Morte,
Che per Morte una volta sol si more;
E tu col tuo colpire,
Uccidi mille, e non si può morire;
Dunque Amore, è men male
La Morte, che'l tuo strale.""" ;
    dcterms:type "PoeticWork" ;
