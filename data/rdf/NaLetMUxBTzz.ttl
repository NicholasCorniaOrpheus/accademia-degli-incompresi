adi:NaLetMUxBTzz a rdfs:Resource ;
    rdfs:label "Ridendo mormorò pietosa maga" ;
    <> adi:a4DrkaZ44fMd,
        adi:gSB2bgNmt66Y ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Ridendo mormorò pietosa maga
Soavi accenti e mi fè sano 'l core
Che ferito languìa d'alto dolore.

Ma di piaga più fera
Mi punse poi la sua bellezz'altera,
Ond'io gridai, gentil maga amorosa,
Crudelmente pietosa,
La tua dolce favella e 'l dolce riso,
Ahi, sanando m'ha ucciso.""" ;
    dc:subject adi:hq5fryYEkuQW ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/243220001010101_000000104000C> ;
    dcterms:type "PoeticWork" ;
