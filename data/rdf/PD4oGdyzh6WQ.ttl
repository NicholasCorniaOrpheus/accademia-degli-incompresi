adi:PD4oGdyzh6WQ a rdfs:Resource ;
    rdfs:label "Con le labia amorose (Pasta)" ;
    <> adi:7Hm4YBgi3joK,
        adi:BafW2wWsEVR7 ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Con le labia amorose
Vezzosetta mia Clori
Four dal candido sen rapij le rose
Sarà vago il veder Poiché le dai
Candide tu & io di bel cinabro
Tu le porti nel sen & io nel labro.""" ;
    dc:subject adi:5RYVLh7yR4s6,
        adi:ULLBEJNmWLfc ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F057010000010101_000000183000C> ;
