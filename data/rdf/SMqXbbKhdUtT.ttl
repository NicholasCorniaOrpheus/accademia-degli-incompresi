adi:SMqXbbKhdUtT a rdfs:Resource ;
    rdfs:label "Fatto è pittor'il Sol di raro ingegno" ;
    <> adi:CVNqJuQekRCD,
        adi:NDRQPafFjYTy ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Fatto è pittor'il Sol di raro ingegno,
Che con pennel di luce un'ombra finge,
E per ritrarmi al vivo, in terra pinge.
Pittor'in ver di peregrin disegno,
Ne la polve m'adombra;
Perch'altro non son'io, che polve, & ombra.""" ;
    dc:description "The poet relates the shadows created by the Sun's light as instant paintings. The final verses allude to the moralistic goal of the poem, considering the author at the same level of dust and shadows." ;
    dc:subject adi:DHTHVpQnvYLr,
        adi:KuorvRGvXbTz ;
    dcterms:type "PoeticWork" ;
