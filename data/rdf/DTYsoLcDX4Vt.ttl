adi:DTYsoLcDX4Vt a rdfs:Resource ;
    rdfs:label "Ove ne lasci, ove Signor ne vai" ;
    <> adi:NGrxmrXecZ5w,
        adi:mtmLGiiqGNUj ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Ove ne lasci, ove Signor ne vai
Innocente a soffrir l'ultime pene?
Dunque pur dee morir, con tanti guai,
Chi vive ne consola, e ne mantiene?
Gierusalem, Gierusalem, che fai?
Chi la destra tonante in Ciel ritiene
Del giusto Dio, perch'una pioggia horrenda
Di fiamme ultrici, hor fuora te ne scenda?""" ;
    dc:subject adi:4dyo9zXijchN,
        adi:GJNhc2VqDoFL ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
    wdt:P870 adi:nKCWTNSaUJQU ;
    ns1:P180 adi:kcWr3rLLCUsP ;
    ns1:P2551 adi:FPYzaHuDcPWK .

