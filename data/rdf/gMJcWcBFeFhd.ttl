adi:gMJcWcBFeFhd a rdfs:Resource ;
    rdfs:label "Se sempre ritrovasti in me l'amore" ;
    <> adi:FqBWCu5YvZzH,
        adi:LnJe2SznsdSA,
        adi:MrwKLwDFwkkz ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """Se sempre ritrovasti in me l'amore,
In me la fede immobil o sincera,
Non pensare ritrovarla unqua minore
O vadi autunno, o passi pimavera.
Sol vo' che riguardiamo al nostro honore
Ché, machiati ambidoi d'altra maniera,
Giamai di pianto asciugarei le gote
Fin'alla morte, o più, se più si pote.""" ;
    dc:subject adi:2Z7GLcNcoqn4,
        adi:jNVGi7b6DTsP ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:LnJe2SznsdSA ;
