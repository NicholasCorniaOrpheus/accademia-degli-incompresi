adi:BTm85M3937rM a rdfs:Resource ;
    rdfs:label "Quella che 'n voi bontà quasi infinita" ;
    <> adi:UXvzgo4tYk5F,
        adi:bGRJWn5bVFvx ;
    pdc:text """Quella che 'n voi bontà quasi infinita
Amai, nel vostro e mio giovanil fiore,
E quella, non di lei virtù minore,
Di dare ai bronzi moto, ai i marmi vita,
Di giorno in giorno in voi col tempo è gita
Crescendo, sì che quella il primo honore
Quest' ha il secondo et vi nasce e vi muore
Il sol vostro valor doppio d'addita.""" ;
    dc:subject adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:QmQprBXKudMJ ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    ns1:P180 adi:bwjZU6AmoTyh,
        adi:fibtk65Ak5cM ;
    ns1:P2551 adi:NtX3nd34H3Wn .

