adi:283fCXKnjYhy a rdfs:Resource ;
    rdfs:label "Forse è cagion l'Aurora" ;
    <> adi:4fam9RTzpsG4,
        adi:6RgbbkFR4hhh,
        adi:exrSSpj73NMW ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Forse è cagion l'Aurora
Di questo bel concento,
Che fan le fronde, e i rami, e l'acque, e'l vento?
Oh con sì dolce modo
Il Ciel Tarquinia honora,
E per lei de la terra s'innamora?
I' odo (o parmi) i' odo
La voce ella è pur dessa
Ecco Tarquinia viene, Amor s'appressa.""" ;
    dc:subject adi:TAip7T448drv,
        adi:ndYmAKz88N5Q ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/023520000101_PPPP00286400C> ;
    dcterms:type "PoeticWork" ;
