adi:KFBcTPzv2qZo a rdfs:Resource ;
    rdfs:label "Io che giovin cantai d'ardenti amori" ;
    <> adi:GfNhWec4EkAr,
        adi:S2FS7sVvFihi,
        adi:WzC4uAhzQRBw ;
    pdc:poeticType adi:nkvGUfVFSUHZ ;
    pdc:text """Io che giovin cantai d'ardenti amori
I dubbiosi piacer, le certe pene,
Poi destai per le selve tra i pastori
Zampogne inculte, e semplicette avene:
Indi l'arte e l'oprar' a i buoni cultori
Mostrai ch'ai campi e gregge si conviene,
Hor de i miei giorni alle stagion mature
Narrerò di Gyron l'alte avventure:""" ;
    dc:subject adi:3ruLTSyv8VeY,
        adi:8GvHmwR26GRn ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:Wvnraxko77uh ;
