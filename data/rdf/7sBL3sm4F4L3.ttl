adi:7sBL3sm4F4L3 a rdfs:Resource ;
    rdfs:label "Oh dolorosi amanti" ;
    <> adi:4qz9ARSJbUuJ,
        adi:EVLHUYPjvWMB ;
    pdc:poeticType adi:o3hHdDx7u4u2 ;
    pdc:text """Oh dolorosi amanti;
Che spregiando la vita,
Solo bramate chi morir v'invita.
Nudriti sol di pianti,
D'angoscia, di sospir, d'acerba doglia.
Et io meschino il provo:
Che'n tanto mal mi trovo,
Che l'alma ogn'hora di piacer si spoglia;
Et con irata voglia
Gridando dico, oh ciel quando farai,
Ch'io possa uscir di sì infiniti lai.""" ;
    dc:subject adi:dR7sSTMz4jjt ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    wdt:P870 adi:Rpi7M9nmjho7 ;
    skos:altLabel "O dolorosi amanti" ;
