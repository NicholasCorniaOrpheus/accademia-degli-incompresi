adi:WXWHJZNWk6dY a rdfs:Resource ;
    rdfs:label "Cantava in riva al fiume" ;
    <> adi:MW7UE9R8m7LS,
        adi:UJZ7Qau55M9Z ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Cantava in riva al fiume
Tirsi d'Eleonora;
E rispondean le selve, e l'onde honora,
E parea mormorando
Dir l'ora, hora, ch'appare
L'Aurora par, che lieta esca dal mare.
Hor chi l'honora amando?
E l'acque insieme ei rami;
Hor chi fia, che l'honori, e che non l'ami?""" ;
    dc:subject adi:ZfsD5EcdZsxp ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F023020000101_PPPP00286400C> ;
    dcterms:type "PoeticWork" ;
