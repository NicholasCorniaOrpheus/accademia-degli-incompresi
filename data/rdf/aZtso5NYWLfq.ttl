adi:aZtso5NYWLfq a rdfs:Resource ;
    rdfs:label "Quivi sospiri pianti ed alti guai (Renaldi)" ;
    <> adi:Kq4PswoDPxtR,
        adi:Tq6xrgYWvUCg,
        adi:WeH6J3HeemDe ;
    pdc:poeticType adi:NmP27mSFqcCQ ;
    pdc:text """Quivi sospiri, pianti e alti guai
risonavan per l'aere sanza stelle,
per ch'io al cominciar ne lagrimai.
Diverse lingue, orribili favelle,
parole di dolore, accenti d'ira,
voci alte e fioche, e suon di man con elle
facevano un tumulto, il qual s'aggira
sempre in quell'aura sanza tempo tinta,
come la rena quando turbo spira.""" ;
    dc:subject adi:dR7sSTMz4jjt ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http://repim.unibo.it/resource/WORK/241750001010101_000000204300> ;
    dcterms:type "MusicComposition" ;
