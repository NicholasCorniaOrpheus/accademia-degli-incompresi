    ns1:P304 "44" ;
    ns1:P958 "Of many Worlds in this World." .

adi:cPDu2Q5AdiBX-TZAtwcUMLgSh a rdf:Statement ;
    bf:Role adi:FEP2RHUGTuJR ;
