adi:PBJzyohJ4tz4 a rdfs:Resource ;
    rdfs:label "E dove non potea la debil voce" ;
    <> adi:3tBDveUQba76,
        adi:GdXWhx79h26y ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """E dove non potea la debil voce,
Supliva il pianto e'l batter palma a palma.
Dove fuggi, crudel, così veloce?
Non ha il tuo legno la debita salma.
Fa che lievi me ancor: poco gli nuoce
Che porti il corpo, poi che porta l'alma.
E con le braccia e con le vesti segno
Fa tuttavia, perché ritorni il legno.""" ;
    dc:subject adi:Pfqef5YBTXjD ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F018930000101_PPPP00015400C>,
        <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=31102> ;
    dcterms:type "PoeticWork" ;
