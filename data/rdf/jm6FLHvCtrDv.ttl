adi:jm6FLHvCtrDv a rdfs:Resource ;
    rdfs:label "Angelica, se'l mondo" ;
    <> adi:YwBMpr45NG8a,
        adi:iRCYDktcXg33 ;
    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Angelica, se'l mondo
Con occulti tormenti
E vivo Inferno di pensier nocenti,
Per te solo il mio petto
Di contento è ricetto;
Poiché, con suon giocondo,
Temprando i pensier miei,
Ne l'Inferno de' vivi Angiola sei.""" ;
    dc:description "Madrigale in praise of Angelica N., musician." ;
