adi:nQCWZj4YD9Ux a rdfs:Resource ;
    rdfs:label "Se gli Eterni pensieri" ;
    <> adi:Hyw2JvyN8B9h,
        adi:j7DoSeBZLZrw ;
    pdc:poeticType adi:ZTekfwVRnUbd ;
    pdc:text """Se gli Eterni pensieri
Che ne i Pianeti il Divin fabro incise,
Fosse Huomo caduco a cancellar bastante
Sarian del Ciel rotante
L'influenze derise,
Che sol forano i Fati i suoi Voleri,
Ah non sia mai chi speri
Tor le Leggi al Destin, o crudo, o pio,
Se Colassù chi le dispone è Dio.""" ;
    dc:subject adi:mXh2Rsv82eCY ;
    dcterms:type "PoeticWork" ;
