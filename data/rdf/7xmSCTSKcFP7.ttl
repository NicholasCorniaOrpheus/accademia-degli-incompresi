adi:7xmSCTSKcFP7 a rdfs:Resource ;
    rdfs:label "Erasi al Sole il mio bel Sole assiso" ;
    <> adi:G6nQquS3B9os,
        adi:QQU75XRhzWKV ;
    pdc:poeticType adi:LEWu9yEF83UP ;
    pdc:text """Erasi al Sole il mio del Sole assiso
Che pari altri non trova;
E l'un ver l'altro a prova
Sciolto il cresp'oro suo di Paradiso
Si specchiava nel viso del suo Sole;
E'n questo specchio, e'n quello
Si rivedea sì bello,
Ch'al mio Sole parea d'essere il Sole
Et al Sole il mio Sole.""" ;
    dc:subject adi:JtFVPwAgP7uA ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F009680000101_PPPP00282500C> ;
    dcterms:type "PoeticWork" ;
