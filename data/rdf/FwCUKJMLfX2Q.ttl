adi:FwCUKJMLfX2Q a rdfs:Resource ;
    rdfs:label "Io grido Pace, e Amor mi sfida a guerra" ;
    <> adi:GpCVYdi8S5s2,
        adi:bc8ENq8LbxeG ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Io grido Pace, e Amor mi sfida a guerra
Strali rinforza, ed d'armi
Ogni riparo, ogni difesa atterra;
Se vuoi, ch'io mi disarmi,
O lascia di ferire,
O sia mia Pace, che ti porge ardire,
Ché mentr'è Pace, non convien ch'huom s'armi.
Ma tempo è, occhi vivaci,
Di lasciar l'armi, e guerreggiar co'baci.""" ;
    dc:subject adi:9XkyVfBG5hTX,
        adi:KX53XRWp7L4v ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F050630000101_PPPP00195700C> ;
