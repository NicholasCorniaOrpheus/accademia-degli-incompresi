    pdc:poeticType adi:NiFCVHMLTGkp ;
    pdc:text """Sapie cari signori
Che queste bizzarrie
È xe de varij autori
Che per contento sol de li so cori
S'è tolto spasso con ste fantasie
Così digand'andar de più saori.""" ;
