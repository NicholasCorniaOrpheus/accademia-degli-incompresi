adi:mQokgjSrYcDE a rdfs:Resource ;
    rdfs:label "Oh fameliche inique e fiere Harpie" ;
    <> adi:3tBDveUQba76,
        adi:GdXWhx79h26y ;
    pdc:poeticType adi:JdCmvSXCtJKC ;
    pdc:text """Oh fameliche inique e fiere Harpie
Ch'all'accecata Italia e d'error piena
Per punir forse antique colpe rie
In ogni mensa alto giudicio mena,
Innocenti fanciulli e madri pie
Cascan di fame, e veggon ch'una cena
Di questi mostri rei tutto divora
Ciò che del viver lor sostegno fora""" ;
    dc:subject adi:iWMn6FHJ2W74 ;
    dcterms:identifier <https://repim.itatti.harvard.edu/resource/?uri=http%3A%2F%2Frepim.unibo.it%2Fresource%2FWORK%2F019960000101_PPPP00015400C>,
        <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=26621> ;
    dcterms:type "PoeticWork" ;
    wdt:P1343 adi:krJNW7CuZmu4 ;
    wdt:P31 adi:jAqiUUC7GsgE ;
    skos:altLabel "O famelice inique e fiere arpie" ;
