adi:U53GqZxC4L7g a rdfs:Resource ;
    rdfs:label "Questa Luna, che sorge" ;
    <> adi:HjhtUu9o8iuQ,
        adi:W4sWHRRv6ZXt ;
    pdc:poeticType adi:XnhvNmB6wXvC ;
    pdc:text """Questa Luna, che sorge
In grembo quasi a l'orse
A i Lidi più remoti 'l lume porge.
Luce, e non mai tramonta,
E nell'Atlante forse
Più chiari spiega i rai, che dove sponta
Cinthia così più suole
Risplender lungi, che congionta al Sole.""" ;
    dc:subject adi:7SzNifkq9dZo,
        adi:ndYmAKz88N5Q ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:jAqiUUC7GsgE ;
