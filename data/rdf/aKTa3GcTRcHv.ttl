adi:aKTa3GcTRcHv a rdfs:Resource ;
    rdfs:label "È di corpo Tancredi agile e sciolto" ;
    <> adi:Lv8EW8V8UKXk,
        adi:UJZ7Qau55M9Z ;
    pdc:poeticType adi:QKnFCoKHDFvG ;
    pdc:text """È di corpo Tancredi agile e sciolto,
E di man velocissimo, e di piede,
Sovrasta a lui con l’alto capo, e molto
Di grossezza di membra Argante eccede.
Girar Tancredi inchino, e in se raccolto
Per aventarsi, e sottentrar sì vede:
E con la spada sua la spada trova
Nemica, e'n disviarla usa ogni prova.""" ;
    dc:subject adi:mFiPL4Hssca2 ;
    dcterms:identifier <https://versologie.cz/poetree/browser/poem?corpus=it&id_poem=35264> ;
    dcterms:type "PoeticWork" ;
    wdt:P31 adi:fYpqbjX78ztP ;
    wdt:P870 adi:85kGqMwffVs7 ;
    ns1:P180 adi:5VUDxWtHbGZH,
        adi:JbmJpbVTAmsh,
