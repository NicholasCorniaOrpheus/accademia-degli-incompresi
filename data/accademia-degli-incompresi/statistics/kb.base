views:
  - type: table
    name: Table
  - type: table
    name: poems
    filters:
      or:
        - class == "PoeticWork"
    order:
      - file.name
      - local_asset_path
      - contributor
      - part_of
      - text
    sort:
      - property: file.name
        direction: ASC
    rowHeight: medium
  - type: table
    name: agents
    filters:
      and:
        - class == "Agent"
    order:
      - file.name
      - identifier
      - image
      - catalog_identifier
      - occupation
      - related_to
      - work_location
      - interested_in
      - member_of
      - notable_work
  - type: table
    name: music
    filters:
      and:
        - class == "NotatedMusic"
    order:
      - file.name
      - identifier
      - instance_of
      - instrumentation
  - type: table
    name: bibliography
    filters:
      and:
        - class == "BibliographicResource"
    order:
      - file.name
      - aliases
      - citation
      - bibtex
    sort:
      - property: file.name
        direction: ASC
      - property: bibtex
        direction: ASC
      - property: local_asset_path
        direction: ASC
  - type: table
    name: books
    filters:
      and:
        - class == "Book"
    order:
      - file.name
      - contributor
      - has_version
      - identifier
      - subject
  - type: table
    name: compositions
    filters:
      and:
        - class == "MusicComposition"
    order:
      - file.name
      - identifier
      - digitized
      - contributor
      - text
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: organizations
    filters:
      and:
        - class == "Organisation"
        - instance_of != ["[[academy]]"]
        - instance_of != ["[[academia fictiva]]"]
    order:
      - file.name
      - identifier
      - official_website
  - type: table
    name: academies
    filters:
      and:
        - class == "Organisation"
        - instance_of.containsAny(link("academy"), link("academia fictiva"))
    order:
      - file.name
      - catalog_identifier
      - identifier
      - member
      - described_by_source
  - type: table
    name: concepts
    filters:
      and:
        - class == "Concept"
    order:
      - file.name
      - identifier
      - instance_of
      - opposite_of
  - type: table
    name: compositions_with_unique_text
    filters:
      and:
        - class == "MusicComposition"
        - "!text.isEmpty()"
    order:
      - file.name
      - identifier
      - digitized
      - poetic_type
      - metre
      - depicts
      - subject
      - text
