@article{camposbenitezAnalogyVisualContent2018,
  title = {Analogy and {{Visual Content}}: {{The Logica}} Memorativa of {{Thomas Murner}}},
  shorttitle = {Analogy and {{Visual Content}}},
  author = {Campos Benítez, Juan Manuel},
  date = {2018-12-27},
  journaltitle = {Philosophies},
  shortjournal = {Philosophies},
  volume = {4},
  number = {1},
  pages = {2},
  issn = {2409-9287},
  doi = {10.3390/philosophies4010002},
  url = {https://www.mdpi.com/2409-9287/4/1/2},
  urldate = {2024-12-11},
  abstract = {In this article, after some thoughts on medieval logic and teaching, we present Thomas Murner’s text, Logica memorativa, showing some of his mnemonic strategies for the student to learn logic quickly. Murner offers a type of “flash cards” that illustrate much of the teaching of logic at the beginning of the sixteenth century. The first impression is visual, because the cards do not contain words that illustrate their content. Murner’s exposition rests on analogies between logic themes that are explained and the visual images presented.},
  langid = {english}
}
