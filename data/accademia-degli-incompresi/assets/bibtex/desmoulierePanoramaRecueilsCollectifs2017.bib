  url = {http://www.jstor.org/stable/45391164},
  urldate = {2026-08-29},
  abstract = {[This article offers a brief overview of the collections of funeral verses published in Italy from the late 15th to the mid-17th century. Although scholars have studied individual collections of this kind, up to now there were no study dedicated to this production as a whole. This article, based on the research I have done for my doctoral dissertation, aims to fill this gap by giving a survey of the development of this kind of poetry collection from its origins in Humanist circles in Rome and Florence to the 1640, by which time the practice had become widespread in the whole of Italy.]}
}
