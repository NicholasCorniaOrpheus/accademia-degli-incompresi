  title = {Benedetto {{Varchi}}, the {{{\mkbibemph{Accademia}}}}{\mkbibemph{ Degli }}{{{\mkbibemph{Infiammati}}}} , and the {{Origins}} of the {{Italian Academic Movement}}},
  author = {Samuels, Richard S.},
